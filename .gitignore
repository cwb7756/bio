# =============================================
# 依赖目录 (Dependencies)
# =============================================
node_modules/
**/node_modules/
miniprogram_npm/
**/miniprogram_npm/

# =============================================
# 微信开发者工具 (WeChat DevTools)
# =============================================
# 本地私有配置（包含本地设置、编译配置等，不应提交）
project.private.config.json

# 开发者工具本地缓存与上传预览产物
.wechat/
upload/
uploadPreview/

# =============================================
# 环境变量与密钥 (Environment & Secrets)
# =============================================
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
*.cert

# =============================================
# IDE 与编辑器配置 (IDE & Editors)
# =============================================
# Qoder IDE
.qoder/
skills-lock.json

# 其他编辑器
.vscode/
.idea/
.claude/
.agents/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# =============================================
# 项目文档 (Documentation)
# =============================================
# 临时文档、检查报告等整理到此目录（不纳入版本控制）
/docs/

# =============================================
# 比赛相关资料 (Competition Materials)
# =============================================
# 比赛提交材料、手冊等非代码资源，不纳入版本控制
/competition-ali-details/

# =============================================
# 媒体文件 (Media Files)
# =============================================
# 视频、音频等多媒体产物
*.mp4
*.webm
*.mov
*.avi
*.wma
*.mp3
*.wav
audio/
video/
remotion-videos/

# =============================================
# 云函数 (Cloud Functions)
# =============================================
# 云函数依赖已在上方 node_modules 忽略
# 云函数本地日志
cloudfunctions/**/*.log

# =============================================
# 日志文件 (Logs)
# =============================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =============================================
# 构建与临时文件 (Build & Temp)
# =============================================
dist/
build/
.tmp/
tmp/
temp/
*.tmp
.cache/

# =============================================
# 开发工具产物 (Tools Output)
# =============================================
# gen-dna-model.js 的默认输出目录
tools/output/
# img-compress 压缩前的原图备份
tools/img-compress/backup/

# =============================================
# 测试与覆盖率 (Test & Coverage)
# =============================================
coverage/
.nyc_output/

# =============================================
# 操作系统文件 (OS Files)
# =============================================
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
