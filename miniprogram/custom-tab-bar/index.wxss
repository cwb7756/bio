/* ============ 悬浮圆角玻璃质感导航栏 ============ */
.tabbar {
  position: fixed;
  left: 36rpx;
  right: 36rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 999;
}

.tabbar-inner {
  position: relative;
  display: flex;
  align-items: center;
  height: 104rpx;
  border-radius: 52rpx;
  /* 玻璃质感：半透明 + 毛玻璃模糊 */
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(40rpx) saturate(180%);
  -webkit-backdrop-filter: blur(40rpx) saturate(180%);
  /* 细线描绘风格 */
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow:
    0 8rpx 32rpx rgba(30, 38, 33, 0.12),
    0 2rpx 8rpx rgba(30, 38, 33, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

/* ============ 滑块 ============ */
.slider {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 25%;
  background: linear-gradient(135deg, var(--green-soft), var(--green-soft2));
  border: 1.5rpx solid var(--green-accent);
  border-radius: 48rpx;
  box-shadow: 0 2rpx 12rpx rgba(95, 184, 148, 0.25);
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 0;
}

/* ============ 导航项 ============ */
.tab {
  flex: 1;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: var(--gray);
  transition: color 0.3s ease;
}

.tab.on {
  color: var(--green-deep);
}

.tab .icon {
  width: 44rpx;
  height: 44rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab.on .icon {
  transform: scale(1.12);
}

