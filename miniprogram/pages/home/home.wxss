/* pages/home/home.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

/* Tab 页底部留白 */
.page-pad {
  padding-bottom: 180rpx;
}

/* 顶部问候 */
.greeting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 4rpx 24rpx;
}

.greeting-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.greeting-hi {
  font-size: 25rpx;
  color: var(--gray);
  font-weight: 700;
}

.greeting-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 搜索框 */
.search-wrap {
  position: relative;
  margin-top: 24rpx;
}

.cat-mascot {
  position: absolute;
  top: -76rpx;
  right: 24rpx;
  width: 112rpx;
  height: 112rpx;
  z-index: 10;
  transition: transform .3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.cat-mascot:active {
  transform: scale(0.92);
}

.home-search {
  margin-top: 0;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 继续学习卡 */
.continue-card {
  background: linear-gradient(140deg, var(--green-soft2), var(--green-soft));
  border: 4rpx solid var(--line);
  border-radius: 44rpx;
  box-shadow: var(--sh);
  padding: 30rpx 32rpx;
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
}

.continue-tag {
  display: inline-block;
  font-size: 26rpx;
  background: var(--paper);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 2rpx 20rpx;
  transform: rotate(-2deg);
  font-weight: 600;
}

.continue-title {
  font-size: 34rpx;
  font-weight: 800;
  margin: 18rpx 0 8rpx;
}

.continue-meta {
  font-size: 25rpx;
  color: var(--ink-soft);
  margin-bottom: 22rpx;
}

.progress-bar {
  height: 22rpx;
  background: var(--paper);
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  overflow: hidden;
  width: 80%;
}

.progress-fill {
  height: 100%;
  background: repeating-linear-gradient(
    45deg,
    var(--green-accent),
    var(--green-accent) 12rpx,
    var(--green) 12rpx,
    var(--green) 24rpx
  );
  transition: width .3s;
}

.continue-go {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--green-accent);
  border: 4rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-sm);
}

.go-icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 4rpx;
}

/* 继续学习 - 空态卡片 */
.continue-empty {
  background: linear-gradient(140deg, var(--green-soft2), var(--green-soft));
  border: 4rpx solid var(--line);
  border-radius: 44rpx;
  box-shadow: var(--sh);
  padding: 30rpx 32rpx;
  position: relative;
  overflow: hidden;
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.continue-empty-icon {
  flex: 0 0 80rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--green-accent);
  border: 4rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.continue-empty-icon .icon {
  width: 36rpx;
  height: 36rpx;
  margin-left: 4rpx;
}

.continue-empty-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.continue-empty-title {
  font-size: 32rpx;
  font-weight: 800;
}

.continue-empty-desc {
  font-size: 25rpx;
  color: var(--ink-soft);
}

/* 骨架占位 */
.skeleton-block {
  background: linear-gradient(90deg, var(--green-soft) 25%, var(--green-soft2) 50%, var(--green-soft) 75%);
  background-size: 200% 100%;
  animation: skeleton-pulse 1.2s ease-in-out infinite;
  border-radius: 32rpx;
}

@keyframes skeleton-pulse {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.skeleton-continue {
  height: 200rpx;
  margin-top: 28rpx;
  border-radius: 44rpx;
}

.skeleton-hot {
  height: 104rpx;
  border-radius: 32rpx;
}

/* 功能宫格 */
.grid6 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22rpx;
}

.feat {
  position: relative;
  z-index: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 26rpx 8rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  transition: transform .12s;
}

.feat:active {
  transform: translate(4rpx, 4rpx);
}

.feat-ic {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 4rpx solid var(--line);
}

.feat-icon {
  width: 48rpx;
  height: 48rpx;
}

.ic-g { background: var(--green-soft); }
.ic-g2 { background: var(--green); }
.ic-g3 { background: var(--hl); }
.ic-g4 { background: var(--green-soft2); }
.ic-g5 { background: #E7EEFB; }
.ic-g6 { background: #FBE7EF; }

/* 高级感按钮：流光溢彩旋转光环 */
.feat-premium {
  position: relative;
}

.feat-premium::before,
.feat-premium::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: conic-gradient(from 0deg, #FFA8C5, #FFD89E, #FFF3A0, #A8E6B0, #9AD8FF, #C9B3FF, #FFA8C5);
  animation: feat-premium-flow 3s linear infinite;
  z-index: -1;
}

.feat-premium::before {
  left: -10rpx;
  top: -10rpx;
  right: -10rpx;
  bottom: -10rpx;
}

.feat-premium::after {
  left: -18rpx;
  top: -18rpx;
  right: -18rpx;
  bottom: -18rpx;
  opacity: .5;
  filter: blur(12rpx);
}

@keyframes feat-premium-flow {
  to { transform: rotate(360deg); }
}

.feat-name {
  font-size: 25rpx;
  font-weight: 700;
}

/* 热门考点列表 */
.hot-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hot-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 22rpx 26rpx;
}

.hot-no {
  flex: 0 0 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  border: 3rpx solid var(--line);
  border-radius: 50%;
  background: var(--green);
}

.hot-no-y {
  background: var(--hl);
}

.hot-txt {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hot-title {
  font-size: 28rpx;
  font-weight: 700;
}

.hot-desc {
  font-size: 23rpx;
  color: var(--gray);
}

.hot-fire {
  font-size: 24rpx;
  color: var(--green-deep);
  font-weight: 700;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.hot-fire .icon {
  width: 28rpx;
  height: 28rpx;
}
