<!--pages/home/home.wxml-->
<view class="page-container">
  <view class="bg-dots"></view>

  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <view class="page-body">
    <view class="page-pad">
      <!-- 顶部问候 -->
      <view class="greeting">
        <view class="greeting-text">
          <text class="greeting-hi">{{userName}}，你好</text>
          <text class="greeting-title">今天也要加油鸭</text>
        </view>

      </view>

      <!-- 搜索 -->
      <view class="search-wrap">
        <image class="cat-mascot" src="{{catImage}}" mode="aspectFit"></image>
        <view class="search home-search">
          <view class="icon ic-search search-icon"></view>
          <input
            placeholder="搜考点 / 题目，如：光合作用"
            value="{{searchValue}}"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
            confirm-type="search"
          />
        </view>
      </view>

      <!-- 继续学习 -->
      <block wx:if="{{loading}}">
        <view class="skeleton-block skeleton-continue"></view>
      </block>
      <view wx:elif="{{continueLearning}}" class="continue-card" bindtap="continueStudy">
        <view class="continue-tag">{{continueLearning.tag}}</view>
        <view class="continue-title">{{continueLearning.title}}</view>
        <view class="continue-meta">{{continueLearning.meta}}</view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{continueLearning.progressText}};"></view>
        </view>
        <view class="continue-go">
          <view class="icon ic-play go-icon"></view>
        </view>
      </view>
      <view wx:else class="continue-empty" bindtap="continueStudy">
        <view class="continue-empty-icon">
          <view class="icon ic-play"></view>
        </view>
        <view class="continue-empty-text">
          <text class="continue-empty-title">{{isLoggedIn ? '开始你的第一节生物课' : '请登录'}}</text>
          <text class="continue-empty-desc">探索细胞、遗传与生态的奥秘</text>
        </view>
        <view class="continue-go">
          <view class="icon ic-play go-icon"></view>
        </view>
      </view>

      <!-- 功能宫格 -->
      <view class="sec-title">
        <text class="u">学习工具</text>
      </view>
      <view class="grid6">
        <view
          wx:for="{{features}}"
          wx:key="name"
          class="feat"
          data-path="{{item.path}}"
          bindtap="goFeature"
        >
          <view class="feat-ic ic-{{item.bg}}">
            <view class="icon {{item.icon}} feat-icon"></view>
          </view>
          <text class="feat-name">{{item.name}}</text>
        </view>
      </view>

      <!-- 热门考点 -->
      <view class="sec-title">
        <text class="u">热门考点</text>
        <view class="more" bindtap="goAllTopics"><text>全部</text><view class="icon ic-chevron-right more-icon"></view></view>
      </view>
      <view class="hot-list">
        <view
          wx:if="{{!loading}}"
          wx:for="{{hotTopics}}"
          wx:key="no"
          class="hot-item"
          data-course-id="{{item.courseId}}"
          bindtap="goHotTopic"
        >
          <view class="hot-no {{item.hot ? 'hot-no-y' : ''}}">{{item.no}}</view>
          <view class="hot-txt">
            <text class="hot-title">{{item.title}}</text>
            <text class="hot-desc">{{item.desc}}</text>
          </view>
          <view class="hot-fire"><view class="icon ic-fire"></view><text>{{item.fire}}</text></view>
        </view>
        <view wx:if="{{loading}}" class="skeleton-block skeleton-hot" wx:for="{{[1,2,3]}}" wx:key="*this"></view>
      </view>
    </view>
  </view>
</view>
