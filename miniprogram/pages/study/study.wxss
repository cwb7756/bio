/* pages/study/study.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

/* Tab 页底部留白 */
.page-pad {
  padding-bottom: 180rpx;
}

/* 页面标题 */
.page-header {
  margin: 8rpx 4rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--ink-soft);
}

.study-segment {
  margin-bottom: 28rpx;
}

/* 学习概览 */
.study-overview {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(140deg, var(--green-soft2), var(--green-soft));
  border: 4rpx solid var(--line);
  border-radius: 40rpx;
  box-shadow: var(--sh);
  padding: 32rpx 20rpx;
  margin-bottom: 8rpx;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.overview-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--green-deep);
}

.overview-label {
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

.overview-divider {
  width: 3rpx;
  height: 60rpx;
  background: var(--gray-line);
  border-radius: 2rpx;
}

/* 加载中 */
.study-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--ink-soft);
  font-size: 28rpx;
}

/* 章节列表 */
.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.chapter-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 28rpx 26rpx;
  transition: transform .12s;
}

.chapter-card:active {
  transform: translate(4rpx, 4rpx);
}

.ch-icon-wrap {
  position: relative;
  flex: 0 0 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  border: 4rpx solid var(--line);
  background: var(--green-soft);
}

.ch-done .ch-icon-wrap {
  background: var(--green);
}

.ch-lock .ch-icon-wrap {
  background: var(--gray-line);
}

.ch-icon {
  width: 52rpx;
  height: 52rpx;
}

.ch-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--green-accent);
  border: 3rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ch-badge .icon {
  width: 20rpx;
  height: 20rpx;
}

.ch-badge-lock {
  background: var(--gray);
}

.ch-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ch-title {
  font-size: 30rpx;
  font-weight: 700;
}

.ch-meta {
  font-size: 24rpx;
  color: var(--gray);
}

.ch-progress {
  height: 16rpx;
  background: var(--green-soft);
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  overflow: hidden;
  margin-top: 4rpx;
}

.ch-progress-fill {
  height: 100%;
  background: var(--green-accent);
  transition: width .3s;
}

.ch-lock .ch-progress-fill {
  background: var(--gray);
}

.ch-arrow {
  flex: 0 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ch-arrow .icon {
  width: 32rpx;
  height: 32rpx;
}
