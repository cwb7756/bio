/* pages/study/study.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

/* Tab 页底部留白 */
.page-pad {
  padding-bottom: 180rpx;
}

/* 页面标题 */
.page-header {
  margin: 8rpx 4rpx 28rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--ink-soft);
}

/* 知识地图入口 */
.map-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
}

.map-entry:active {
  transform: translate(4rpx, 4rpx);
  box-shadow: none;
}

.map-entry-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.map-entry-icon {
  width: 44rpx;
  height: 44rpx;
}

.map-entry-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.map-entry-title {
  font-size: 30rpx;
  font-weight: 800;
}

.map-entry-desc {
  font-size: 23rpx;
  color: var(--gray);
}

.map-entry-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.map-entry-percent {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--green-deep);
}

.map-entry-arrow {
  width: 32rpx;
  height: 32rpx;
}

/* 学习概览 */
.study-overview {
  position: relative;
  overflow: visible;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: linear-gradient(140deg, var(--green-soft2), var(--green-soft));
  border: 4rpx solid var(--line);
  border-radius: 40rpx;
  box-shadow: var(--sh);
  padding: 32rpx 20rpx;
  margin-top: 110rpx;
  margin-bottom: 8rpx;
}

/* 趴在卡片上框的猫咪装饰（不响应点击） */
.overview-cat {
  position: absolute;
  top: -108rpx;
  right: 24rpx;
  width: 180rpx;
  height: 130rpx;
  pointer-events: none;
  z-index: 2;
}

.overview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.overview-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--green-deep);
}

.overview-label {
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

.overview-divider {
  width: 3rpx;
  height: 60rpx;
  background: var(--gray-line);
  border-radius: 2rpx;
}

/* 加载中 */
.study-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  color: var(--ink-soft);
  font-size: 28rpx;
}

/* 章节列表 */
.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.chapter-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 28rpx 26rpx;
  transition: transform .12s;
}

.chapter-card:active {
  transform: translate(4rpx, 4rpx);
}

.ch-icon-wrap {
  position: relative;
  flex: 0 0 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  border: 4rpx solid var(--line);
  background: var(--green-soft);
}

.ch-done .ch-icon-wrap {
  background: var(--green);
}

.ch-icon {
  width: 52rpx;
  height: 52rpx;
}

.ch-badge {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--green-accent);
  border: 3rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ch-badge .icon {
  width: 20rpx;
  height: 20rpx;
}

.ch-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.ch-title {
  font-size: 30rpx;
  font-weight: 700;
}

.ch-meta {
  font-size: 24rpx;
  color: var(--gray);
}

.ch-progress {
  height: 16rpx;
  background: var(--green-soft);
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  overflow: hidden;
  margin-top: 4rpx;
}

.ch-progress-fill {
  height: 100%;
  background: var(--green-accent);
  transition: width .3s;
}

.ch-arrow {
  flex: 0 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ch-arrow .icon {
  width: 32rpx;
  height: 32rpx;
}

.ch-add-nb {
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--green-accent);
  border-radius: 16rpx;
  background: var(--green-soft);
}

.ch-add-nb .icon {
  width: 28rpx;
  height: 28rpx;
}

/* 未登录引导空状态 */
.login-guide {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 60rpx 60rpx;
  gap: 16rpx;
}

.lg-cat {
  width: 220rpx;
  height: 220rpx;
}

.lg-title {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.lg-desc {
  font-size: 26rpx;
  color: var(--ink-soft);
  text-align: center;
  line-height: 1.6;
  white-space: pre-line;
}

.lg-btn {
  margin-top: 28rpx;
}
