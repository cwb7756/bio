/* pages/profile/profile.wxss */

/* ============ 导航栏 ============ */
.skip-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--green-deep);
}

/* ============ 提示语 ============ */
.setup-hint {
  background: var(--green-soft);
  border: 3rpx solid var(--green-accent);
  border-radius: 28rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 32rpx;
}

.setup-hint text {
  font-size: 26rpx;
  color: var(--green-deep);
  font-weight: 600;
  line-height: 1.5;
}

/* ============ 表单卡片 ============ */
.form-card {
  border: 4rpx solid var(--line);
  border-radius: 44rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* ---- 头像区域 ---- */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0 24rpx;
}

/* 重置 button 默认样式（open-type="chooseAvatar" 头像选择按钮） */
button.avatar-btn {
  background: transparent;
  border: none;
  border-radius: 0;
  margin: 0;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}

button.avatar-btn::after {
  border: none;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid var(--line);
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  box-shadow: var(--sh-sm);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-default {
  width: 80rpx;
  height: 80rpx;
  opacity: 0.5;
}

.avatar-camera {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  background: var(--green-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-sm);
}

.camera-icon {
  width: 28rpx;
  height: 28rpx;
  filter: brightness(0) invert(1);
}

.avatar-hint {
  font-size: 24rpx;
  color: var(--gray);
  font-weight: 600;
}

/* ---- 字段标签 ---- */
.field-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  padding: 4rpx 8rpx 0;
}

.field-required {
  color: #E88;
  font-size: 28rpx;
}

/* ---- 输入框 ---- */
.input-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--bg);
  padding: 22rpx 28rpx;
  transition: border-color .2s;
}

.input-row:focus-within {
  border-color: var(--green-accent);
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--f-body);
  font-size: 30rpx;
  color: var(--ink);
}

.input-placeholder {
  color: var(--gray);
  font-size: 28rpx;
}

/* ---- 年级选择 ---- */
.grade-segment {
  margin: 0;
}

.grade-segment .seg-item {
  padding: 20rpx 0;
  font-size: 28rpx;
}

/* ---- 可选区域分割线 ---- */
.optional-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0 4rpx;
}

.optional-divider .divider-line {
  flex: 1;
  height: 3rpx;
  background: var(--gray-line);
  border-radius: 2rpx;
}

.optional-divider .divider-text {
  font-size: 22rpx;
  color: var(--gray);
  font-weight: 600;
  white-space: nowrap;
}

/* ============ 保存按钮 ============ */
.save-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  border-radius: 36rpx 30rpx 38rpx 28rpx;
  margin-top: 36rpx;
}

.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}
