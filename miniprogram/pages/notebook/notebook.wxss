/* pages/notebook/notebook.wxss */
.page-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.nav-count {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--gray);
  padding: 0 24rpx;
}

/* 工具栏 */
.nb-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 36rpx 8rpx;
}

.nb-hint {
  font-size: 24rpx;
  color: var(--gray);
  font-weight: 600;
}

.nb-auto-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--green-soft);
  border: 3rpx solid var(--green-accent);
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--green-deep);
}

.nb-auto-btn .icon {
  width: 32rpx;
  height: 32rpx;
}

/* 画布滚动区 */
.nb-scroll {
  flex: 1;
  overflow: hidden;
}

.nb-canvas {
  position: relative;
  background-image:
    repeating-linear-gradient(0deg, transparent 0, transparent 79rpx, rgba(95, 184, 148, 0.07) 79rpx, rgba(95, 184, 148, 0.07) 80rpx),
    repeating-linear-gradient(90deg, transparent 0, transparent 79rpx, rgba(95, 184, 148, 0.07) 79rpx, rgba(95, 184, 148, 0.07) 80rpx);
}

/* 笔记卡片 */
.nb-card {
  position: absolute;
  width: 320rpx;
  background: var(--paper);
  border: 4rpx solid var(--line);
  border-radius: 28rpx 24rpx 30rpx 26rpx;
  box-shadow: var(--sh);
  padding: 22rpx 24rpx;
  transition: box-shadow 0.15s, transform 0.15s;
}

.nb-card.nb-dragging {
  box-shadow: var(--sh-soft);
  transform: scale(1.04);
  z-index: 100;
  opacity: 0.95;
}

/* 类型色标 */
.nb-type-knowledge { border-top: 8rpx solid var(--green-accent); }
.nb-type-course { border-top: 8rpx solid #7AB8E8; }
.nb-type-ai { border-top: 8rpx solid #C89AE8; }
.nb-type-mistake { border-top: 8rpx solid #E8A88A; }

.nb-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.nb-type-chip {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: var(--green-soft);
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
  font-size: 21rpx;
  font-weight: 700;
  color: var(--green-deep);
}

.nb-type-chip .icon {
  width: 28rpx;
  height: 28rpx;
}

.nb-del {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(232, 136, 136, 0.12);
}

.nb-del .icon {
  width: 24rpx;
  height: 24rpx;
}

.nb-title {
  display: block;
  font-size: 27rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.4;
  margin-bottom: 8rpx;
  /* 限制两行 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.nb-content {
  display: block;
  font-size: 23rpx;
  color: var(--ink-soft);
  line-height: 1.5;
  /* 限制四行 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.nb-goto {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--green-deep);
  margin-top: 8rpx;
}

.nb-goto .icon {
  width: 28rpx;
  height: 28rpx;
}

.nb-source {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--gray);
}

/* 空态 */
.nb-empty {
  position: absolute;
  top: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.nb-empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.3;
}

.nb-empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--gray);
}

.nb-empty-desc {
  font-size: 25rpx;
  color: var(--gray);
  text-align: center;
  line-height: 1.6;
}

.nb-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  color: var(--gray);
}
