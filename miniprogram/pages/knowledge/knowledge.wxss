/* pages/knowledge/knowledge.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

.nav-icon {
  width: 40rpx;
  height: 40rpx;
}

.star-on {
  color: var(--hl);
}

/* 加载提示 */
.kp-tip {
  padding: 80rpx 0;
  text-align: center;
  color: var(--gray);
  font-size: 28rpx;
}

/* ============ 课程横幅卡 ============ */
.course-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 20rpx;
}

.cb-cover {
  flex: 0 0 160rpx;
  width: 160rpx;
  height: 100rpx;
  border-radius: 20rpx;
  border: 3rpx solid var(--line);
  background: var(--green-soft);
}

.cb-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cb-title {
  font-size: 28rpx;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cb-meta {
  font-size: 22rpx;
  color: var(--gray);
}

.cb-btn {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--green);
  border: 3rpx solid var(--line);
  border-radius: 26rpx;
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: var(--sh-sm);
}

.cb-btn .icon {
  width: 30rpx;
  height: 30rpx;
}

/* ============ 知识点卡片 ============ */
.kp-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.kp-card {
  display: flex;
  gap: 22rpx;
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 24rpx;
}

.kp-badge {
  flex: 0 0 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  border: 4rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-soft);
}

.kp-badge .icon {
  width: 48rpx;
  height: 48rpx;
}

.kp-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.kp-title {
  font-size: 29rpx;
  font-weight: 800;
}

.kp-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
}
