/* pages/login/login.wxss */
.page-container {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ============ 顶部渐变区 ============ */
.hero {
  position: relative;
  background: linear-gradient(160deg, var(--green-accent), var(--green-deep));
  border-bottom-left-radius: 60rpx;
  border-bottom-right-radius: 60rpx;
  padding: 60rpx 36rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  overflow: hidden;
}

/* ---- 返回按钮 ---- */
.hero-back {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  z-index: 3;
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper);
  border: 4rpx solid var(--line);
  border-radius: 32rpx 26rpx 34rpx 24rpx;
  box-shadow: var(--sh-sm);
}

.hero-back:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: 0 0 0 var(--line);
}

.hero-back .icon {
  width: 46rpx;
  height: 46rpx;
}

.hero-deco {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.hero-dna {
  position: absolute;
  top: 40rpx;
  left: 30rpx;
  width: 80rpx;
  height: 80rpx;
  opacity: 0.25;
  filter: brightness(0) invert(1);
}

.hero-leaf {
  position: absolute;
  top: 60rpx;
  right: 40rpx;
  width: 64rpx;
  height: 64rpx;
  opacity: 0.2;
  filter: brightness(0) invert(1);
}

.hero-logo {
  width: 120rpx;
  height: 120rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.hero-logo-img {
  width: 72rpx;
  height: 72rpx;
  filter: brightness(0) invert(1);
}

.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 4rpx;
}

.hero-tagline {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ============ 表单卡片 ============ */
.form-card {
  margin: -50rpx 36rpx 0;
  position: relative;
  z-index: 2;
  border: 4rpx solid var(--line);
  border-radius: 44rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

/* ---- 微信登录按钮 ---- */
.wx-login-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  border-radius: 36rpx 30rpx 38rpx 28rpx;
}

.wx-login-icon {
  width: 40rpx;
  height: 40rpx;
  filter: brightness(0) invert(1);
}

/* ---- 分割线 ---- */
.divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 4rpx 0;
}

.divider-line {
  flex: 1;
  height: 3rpx;
  background: var(--gray-line);
  border-radius: 2rpx;
}

.divider-text {
  font-size: 24rpx;
  color: var(--gray);
  font-weight: 600;
  white-space: nowrap;
}

/* ---- 登录/注册切换 ---- */
.auth-segment {
  border-radius: 30rpx;
}

.auth-segment .seg-item {
  padding: 20rpx 0;
  font-size: 28rpx;
  color: var(--ink-soft);
  transition: color .2s;
}

.auth-segment .seg-item.on {
  background: var(--green);
}

.auth-segment .seg-item.on {
  color: var(--ink);
}

/* ---- 输入框 ---- */
.input-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--bg);
  padding: 22rpx 28rpx;
  transition: border-color .2s;
}

.input-row:focus-within {
  border-color: var(--green-accent);
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.input-field {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--f-body);
  font-size: 30rpx;
  color: var(--ink);
}

.input-placeholder {
  color: var(--gray);
  font-size: 28rpx;
}

/* ---- 登录按钮 ---- */
.email-login-btn {
  width: 100%;
  height: 92rpx;
  font-size: 30rpx;
  border-radius: 30rpx 36rpx 28rpx 34rpx;
}

.btn-disabled {
  opacity: 0.45;
  pointer-events: none;
}

/* ============ 底部 ============ */
.login-footer {
  margin-top: auto;
  padding: 40rpx 36rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.back-home {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--gray);
  padding: 12rpx 32rpx;
  border: 3rpx solid var(--gray-line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

.back-home:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: 0 0 0 var(--gray-line);
}

.version-text {
  font-size: 22rpx;
  color: var(--gray);
  opacity: 0.7;
}
