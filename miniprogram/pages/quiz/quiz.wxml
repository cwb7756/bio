<!--pages/quiz/quiz.wxml-->
<view class="page-container">
  <view class="bg-dots"></view>

  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <!-- 导航栏 -->
  <view class="navbar">
    <view class="icon-btn" bindtap="goBack">
      <view class="icon ic-back nav-icon"></view>
    </view>
    <text class="nav-t">{{navTitle}}</text>
    <view class="icon-btn" bindtap="showMore">
      <view class="icon ic-more nav-icon"></view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="state-block" wx:if="{{loading}}">
    <view class="icon ic-pen state-icon"></view>
    <text class="state-text">正在为你抽取题目...</text>
  </view>

  <!-- 空 / 错误态 -->
  <view class="state-block" wx:elif="{{!currentQuestion}}">
    <view class="icon ic-folder state-icon"></view>
    <text class="state-text">{{emptyHint || '暂无题目'}}</text>
    <view class="btn retry-btn" bindtap="onRetry">
      <view class="icon ic-refresh"></view>
      <text>重试</text>
    </view>
  </view>

  <!-- 答题区 -->
  <block wx:else>
    <!-- 题目进度 -->
    <view class="q-progress">
      <text class="q-num q-num-current">{{current + 1}}</text>
      <view class="q-bar">
        <view class="q-bar-fill" style="width: {{(current + 1) / total * 100}}%;"></view>
      </view>
      <text class="q-num q-num-total">/{{total}}</text>
    </view>

    <view class="page-body" style="padding-bottom: 0;">
      <view class="page-pad">
        <!-- 题干 -->
        <view class="q-stem">
          <view class="q-type">{{currentQuestion.type}}</view>
          <text class="q-text">{{currentQuestion.stem}}</text>
        </view>

        <!-- 选项 -->
        <view class="q-options">
          <view
            wx:for="{{currentQuestion.options}}"
            wx:key="key"
            class="q-opt {{answered && item.key === correctAnswer ? 'opt-right' : ''}} {{answered && selectedOption === index && item.key !== correctAnswer ? 'opt-wrong' : ''}}"
            data-index="{{index}}"
            bindtap="selectOption"
          >
            <view class="opt-key {{answered && item.key === correctAnswer ? 'key-right' : ''}} {{answered && selectedOption === index && item.key !== correctAnswer ? 'key-wrong' : ''}}">{{item.key}}</view>
            <text class="opt-text">{{item.text}}</text>
            <view class="icon ic-check-circle opt-res" wx:if="{{answered && item.key === correctAnswer}}"></view>
            <view class="icon ic-close-circle opt-res" wx:if="{{answered && selectedOption === index && item.key !== correctAnswer}}"></view>
          </view>
        </view>

        <!-- AI 讲解：答对展示题库解析（不生成）；答错由 AI 老师实时生成针对性解析 -->
        <view class="ai-block" wx:if="{{answered}}">
          <view class="ai-avatar">
            <view class="icon ic-bot"></view>
          </view>
          <view class="ai-bubble">
            <view class="ai-who">
              <text>{{correct ? '本题解析' : '● AI 生物老师 · 帮你拆解'}}</text>
            </view>
            <view class="ai-answer">
              <view class="icon ic-check-circle"></view>
              <text>正确答案：{{correctAnswer}}</text>
            </view>
            <!-- 答对：题库静态解析 -->
            <view class="ai-text" wx:if="{{correct && explanation}}">{{explanation}}</view>
            <!-- 答错：AI 流式生成中 / 生成完成 / 失败降级题库解析 -->
            <block wx:if="{{!correct}}">
              <view class="ai-text" wx:if="{{aiText}}">{{aiText}}<text class="ai-cursor" wx:if="{{aiLoading}}">▍</text></view>
              <view class="ai-text ai-thinking" wx:elif="{{aiLoading}}">AI 老师正在分析你的错因...</view>
              <view class="ai-text" wx:elif="{{explanation}}">{{explanation}}</view>
              <view class="ai-text" wx:else>别灰心，把错题收藏起来多复习，下次一定对！</view>
            </block>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作栏 -->
    <view class="action-bar">
      <view class="btn {{finishing ? 'disabled' : ''}}" bindtap="nextQuestion">
        <text>{{finishing ? '上传中...' : (current + 1 === total ? '完成' : '下一题')}}</text>
        <block wx:if="{{!finishing}}">
          <view class="icon ic-arrow-right" wx:if="{{current + 1 < total}}"></view>
          <view class="icon ic-check" wx:else></view>
        </block>
      </view>
    </view>
  </block>
</view>
