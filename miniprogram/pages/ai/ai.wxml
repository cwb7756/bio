<!--pages/ai/ai.wxml-->
<view class="page-container ai-page">
  <view class="bg-dots"></view>

  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <!-- 头部 -->
  <view class="ai-header">
    <view class="ai-header-info">
      <view class="ai-header-avatar">
        <view class="icon ic-bot"></view>
      </view>
      <view class="ai-header-text">
        <text class="ai-header-title">AI 生物老师</text>
        <text class="ai-header-status">● 在线 · 随时为你解答</text>
      </view>
    </view>
    <view class="ai-header-actions">
      <view class="ai-action-btn" bindtap="onToggleHistory" hover-class="ai-action-btn-hover">
        <view class="icon ic-history"></view>
      </view>
      <view class="ai-action-btn" bindtap="onClearChat" hover-class="ai-action-btn-hover">
        <view class="icon ic-eraser"></view>
      </view>
    </view>
  </view>

  <!-- 历史会话抽屉 -->
  <view wx:if="{{showHistory}}" class="history-mask" bindtap="onCloseHistory"></view>
  <view class="history-panel {{showHistory ? 'show' : ''}}">
    <view class="history-header">
      <text class="history-title">历史对话</text>
      <view class="history-new-btn" bindtap="onNewChat" hover-class="history-new-btn-hover">
        <view class="icon ic-chat-plus"></view>
        <text>新对话</text>
      </view>
    </view>
    <scroll-view scroll-y="true" enhanced="true" show-scrollbar="{{false}}" class="history-list">
      <view wx:if="{{sessions.length === 0}}" class="history-empty">暂无历史对话</view>
      <view
        wx:for="{{sessions}}"
        wx:key="_id"
        class="history-item {{item._id === sessionId ? 'active' : ''}}"
        data-id="{{item._id}}"
        bindtap="onTapSession"
        hover-class="history-item-hover"
      >
        <text class="history-item-title">{{item.title}}</text>
        <text class="history-item-time">{{item.timeText}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 聊天区域 -->
  <scroll-view
    class="ai-chat"
    scroll-y="true"
    scroll-into-view="{{scrollIntoView}}"
    scroll-with-animation="true"
    enhanced="true"
    show-scrollbar="{{false}}"
  >
    <view class="chat-welcome">
      <view class="welcome-icon"><view class="icon ic-spark"></view></view>
      <text class="welcome-text">向AI老师提问，获得专业解答</text>
    </view>

    <view
      wx:for="{{messages}}"
      wx:key="ts"
      id="msg-{{index}}"
      class="msg-row msg-{{item.role}}"
    >
      <!-- AI 消息 -->
      <block wx:if="{{item.role === 'ai'}}">
        <view class="msg-avatar">
          <view class="icon ic-bot"></view>
        </view>
        <view class="msg-bubble msg-bubble-ai {{!item.content && isStreaming ? 'streaming' : ''}}">
          <!-- 工具调用框（模型调用工具时显示） -->
          <view wx:if="{{item.toolCall}}" class="tool-call-box {{item.toolCall.status}}">
            <view class="tool-call-icon">
              <view wx:if="{{item.toolCall.status === 'calling'}}" class="tool-call-spinner"></view>
              <view wx:else class="tool-call-check"></view>
            </view>
            <text class="tool-call-label">{{item.toolCall.status === 'calling' ? item.toolCall.label + '...' : '已' + item.toolCall.label}}</text>
          </view>
          <!-- 流式加载指示（AI消息为空且正在流式且无工具调用时） -->
          <view wx:elif="{{!item.content && isStreaming}}" class="typing-indicator">
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
            <view class="typing-dot"></view>
          </view>
          <!-- Markdown 渲染 -->
          <view wx:else class="msg-content md-body">
            <block wx:if="{{item.blocks.length}}">
            <block wx:for="{{item.blocks}}" wx:for-item="b" wx:key="index">
              <view wx:if="{{b.type === 'h1'}}" class="md-h md-h1">
                <template is="md-segs" data="{{segs: b.segments}}" />
              </view>
              <view wx:elif="{{b.type === 'h2'}}" class="md-h md-h2">
                <template is="md-segs" data="{{segs: b.segments}}" />
              </view>
              <view wx:elif="{{b.type === 'h3'}}" class="md-h md-h3">
                <template is="md-segs" data="{{segs: b.segments}}" />
              </view>
              <view wx:elif="{{b.type === 'li'}}" class="md-li">
                <view class="md-li-dot"></view>
                <view class="md-li-body">
                  <template is="md-segs" data="{{segs: b.segments}}" />
                </view>
              </view>
              <view wx:elif="{{b.type === 'oli'}}" class="md-li">
                <text class="md-li-num">{{b.num}}.</text>
                <view class="md-li-body">
                  <template is="md-segs" data="{{segs: b.segments}}" />
                </view>
              </view>
              <view wx:elif="{{b.type === 'quote'}}" class="md-quote">
                <template is="md-segs" data="{{segs: b.segments}}" />
              </view>
              <view wx:elif="{{b.type === 'code'}}" class="md-code">
                <text class="md-code-text" selectable="true">{{b.text}}</text>
              </view>
              <view wx:else class="md-p">
                <template is="md-segs" data="{{segs: b.segments}}" />
              </view>
            </block>
            </block>
            <text wx:else>{{item.content}}</text>
          </view>
        </view>
      </block>

      <!-- 用户消息 -->
      <block wx:else>
        <view class="msg-bubble msg-bubble-user">
          <text class="msg-content" selectable="true">{{item.content}}</text>
        </view>
        <view class="msg-avatar msg-avatar-user">
          <view class="icon ic-student"></view>
        </view>
      </block>
    </view>

    <view style="height: 20rpx;"></view>
  </scroll-view>

  <!-- 快捷问题 -->
  <view class="ai-suggestions">
    <scroll-view scroll-x="true" show-scrollbar="{{false}}" enhanced="true">
      <view class="suggestion-list">
        <view
          wx:for="{{suggestions}}"
          wx:key="*this"
          class="suggestion-chip"
          data-text="{{item}}"
          bindtap="sendSuggestion"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 停止生成按钮（流式输出时显示） -->
  <view wx:if="{{isStreaming}}" style="display: flex; justify-content: center; padding: 8rpx 28rpx;">
    <view bindtap="onStopGenerate" style="font-size: 26rpx; font-weight: 600; border: 3rpx solid var(--line); border-radius: 32rpx; padding: 12rpx 36rpx; background: var(--paper2); box-shadow: var(--sh-sm); color: var(--ink);">
      <text>■ 停止生成</text>
    </view>
  </view>

  <!-- 输入区 -->
  <view class="ai-input-bar">
    <view class="ai-input-wrap">
      <input
        class="ai-input"
        placeholder="输入你的生物问题..."
        value="{{inputValue}}"
        bindinput="onInput"
        bindconfirm="sendMessage"
        confirm-type="send"
        adjust-position="{{true}}"
      />
    </view>
    <view class="ai-send-btn {{inputValue && !isStreaming ? 'active' : ''}} {{isStreaming ? 'disabled' : ''}}" bindtap="sendMessage">
      <text>{{isStreaming ? '回复中' : '发送'}}</text>
    </view>
  </view>
</view>

<!-- 行内片段渲染模板：普通文本 / 加粗 / 行内代码 -->
<template name="md-segs">
  <block wx:for="{{segs}}" wx:for-item="seg" wx:key="index">
    <text wx:if="{{seg.type === 'bold'}}" class="md-bold">{{seg.text}}</text>
    <text wx:elif="{{seg.type === 'code'}}" class="md-inline-code">{{seg.text}}</text>
    <text wx:elif="{{seg.type === 'link'}}" class="md-link" bindtap="onTapLink" data-url="{{seg.url}}">{{seg.text}}</text>
    <image wx:elif="{{seg.type === 'image'}}" src="{{seg.url}}" mode="widthFix" class="md-image" />
    <text wx:else>{{seg.text}}</text>
  </block>
</template>
