/* pages/ai/ai.wxss */
.ai-page {
  position: relative;
  z-index: 1;
  height: 100vh;
}

/* 头部 */
.ai-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 36rpx 20rpx;
  border-bottom: 4rpx solid var(--gray-line);
  background: var(--paper);
}

.ai-header-actions {
  display: flex;
  gap: 16rpx;
}

.ai-back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  background: var(--paper2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-sm);
  flex-shrink: 0;
}

.ai-back-btn .icon {
  width: 34rpx;
  height: 34rpx;
}

.ai-action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  background: var(--paper2);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-sm);
}

.ai-action-btn .icon {
  width: 34rpx;
  height: 34rpx;
}

.ai-action-btn-hover {
  background: var(--green-soft);
  transform: translate(2rpx, 2rpx);
}

.ai-header-info {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ai-header-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid var(--line);
  background: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-sm);
}

.ai-header-avatar .icon {
  width: 40rpx;
  height: 40rpx;
}

.ai-header-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ai-header-title {
  font-size: 34rpx;
  font-weight: 700;
}

.ai-header-status {
  font-size: 24rpx;
  color: var(--green-deep);
  font-weight: 600;
}

/* 聊天区域 */
.ai-chat {
  flex: 1;
  padding: 24rpx 28rpx;
  overflow-y: auto;
}

.chat-welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx 0 40rpx;
}

.welcome-icon .icon {
  width: 72rpx;
  height: 72rpx;
}

.welcome-text {
  font-size: 26rpx;
  color: var(--gray);
  font-weight: 600;
}

/* 消息行 */
.msg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.msg-ai {
  flex-direction: row;
}

.msg-user {
  flex-direction: row-reverse;
}

.msg-avatar {
  flex: 0 0 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  background: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: var(--sh-sm);
}

.msg-avatar .msg-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.msg-avatar .icon {
  width: 36rpx;
  height: 36rpx;
}

.msg-avatar-user {
  background: var(--green-soft);
}

.msg-bubble {
  max-width: 76%;
  padding: 22rpx 26rpx;
  border: 3rpx solid var(--line);
  box-shadow: var(--sh-sm);
}

.msg-bubble-ai {
  border-radius: 12rpx 32rpx 32rpx 32rpx;
  background: var(--paper);
}

.msg-bubble-user {
  border-radius: 32rpx 12rpx 32rpx 32rpx;
  background: var(--green);
}

.msg-content {
  font-size: 28rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 快捷问题 */
.ai-suggestions {
  padding: 12rpx 28rpx;
  border-top: 3rpx solid var(--green-soft);
  background: var(--paper);
}

.suggestion-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.suggestion-chip {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
  border: 3rpx solid var(--line);
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  background: var(--green-soft);
  color: var(--ink);
}

.suggestion-chip:active {
  background: var(--green);
}

/* 输入区 */
.ai-input-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 3rpx solid var(--line);
  background: var(--paper);
}

.ai-input-wrap {
  flex: 1;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper2);
  padding: 18rpx 28rpx;
  box-shadow: var(--sh-sm);
}

.ai-input {
  font-size: 28rpx;
  color: var(--ink);
}

.ai-send-btn {
  flex: 0 0 auto;
  font-size: 28rpx;
  font-weight: 700;
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  padding: 18rpx 32rpx;
  background: var(--gray-line);
  color: var(--gray);
  box-shadow: var(--sh-sm);
  transition: all .12s;
}

.ai-send-btn.active {
  background: var(--green);
  color: var(--ink);
}

.ai-send-btn:active {
  transform: translate(4rpx, 4rpx);
}

/* 发送按钮禁用状态 */
.ai-send-btn.disabled {
  opacity: 0.5;
}

/* 流式加载动画 - 三点跳动 */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  align-items: center;
  padding: 8rpx 0;
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--green-deep);
  animation: typing-bounce 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes typing-bounce {
  0%, 60%, 100% {
    transform: translateY(0);
    opacity: 0.4;
  }
  30% {
    transform: translateY(-10rpx);
    opacity: 1;
  }
}

/* AI消息气泡流式状态 */
.msg-bubble-ai.streaming {
  animation: stream-glow 1.5s infinite ease-in-out;
}

@keyframes stream-glow {
  0%, 100% {
    border-color: var(--line);
  }
  50% {
    border-color: var(--green);
  }
}

/* ---- 工具调用框 ---- */
.tool-call-box {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 14rpx;
  border: 3rpx solid var(--green-soft);
  border-radius: 16rpx;
  background: var(--paper2);
}

.tool-call-box.done {
  border-color: var(--gray-line);
  opacity: 0.7;
}

.tool-call-icon {
  flex-shrink: 0;
  width: 30rpx;
  height: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tool-call-spinner {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid var(--green-soft);
  border-top-color: var(--green-deep);
  border-radius: 50%;
  animation: tool-spin 0.8s linear infinite;
}

@keyframes tool-spin {
  to { transform: rotate(360deg); }
}

.tool-call-check {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: var(--green);
  position: relative;
}

.tool-call-check::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 4rpx;
  width: 8rpx;
  height: 13rpx;
  border: solid var(--paper);
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

.tool-call-label {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--green-deep);
}

.tool-call-box.done .tool-call-label {
  color: var(--gray);
  font-weight: 500;
}

/* ---- 历史会话抽屉 ---- */
.history-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(30, 38, 33, 0.35);
  z-index: 1000;
}

.history-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  max-height: 62vh;
  background: var(--paper);
  border-bottom: 4rpx solid var(--line);
  box-shadow: var(--sh-soft);
  z-index: 1001;
  transform: translateY(-105%);
  transition: transform 0.25s ease;
  display: flex;
  flex-direction: column;
}

.history-panel.show {
  transform: translateY(0);
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx 16rpx;
}

.history-title {
  font-size: 30rpx;
  font-weight: 700;
}

.history-new-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 25rpx;
  font-weight: 600;
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 8rpx 20rpx;
  background: var(--green-soft);
  box-shadow: var(--sh-sm);
}

.history-new-btn .icon {
  width: 28rpx;
  height: 28rpx;
}

.history-new-btn-hover {
  background: var(--green);
}

.history-list {
  max-height: 46vh;
  padding: 0 24rpx 24rpx;
}

.history-empty {
  text-align: center;
  font-size: 26rpx;
  color: var(--gray);
  padding: 48rpx 0;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border: 3rpx solid var(--gray-line);
  border-radius: 20rpx;
  background: var(--paper2);
}

.history-item.active {
  border-color: var(--green-deep);
  background: var(--green-soft);
}

.history-item-hover {
  background: var(--green-soft);
}

.history-item-title {
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-item-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--gray);
}

/* ---- Markdown 渲染 ---- */
.md-body {
  white-space: normal;
}

.md-p {
  margin: 8rpx 0;
}

.md-h {
  font-weight: 700;
  line-height: 1.4;
}

.md-h1 {
  font-size: 34rpx;
  margin: 18rpx 0 10rpx;
}

.md-h2 {
  font-size: 31rpx;
  margin: 16rpx 0 8rpx;
}

.md-h3 {
  font-size: 29rpx;
  margin: 12rpx 0 6rpx;
}

.md-bold {
  font-weight: 700;
  color: var(--ink);
}

.md-inline-code {
  font-family: Consolas, Monaco, monospace;
  font-size: 25rpx;
  background: var(--green-soft);
  border: 2rpx solid var(--gray-line);
  border-radius: 6rpx;
  padding: 0 8rpx;
}

.md-li {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin: 8rpx 0;
}

.md-li-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--green-deep);
  margin-top: 16rpx;
}

.md-li-num {
  flex-shrink: 0;
  font-weight: 700;
  color: var(--green-deep);
}

.md-li-body {
  flex: 1;
  min-width: 0;
}

.md-quote {
  border-left: 6rpx solid var(--green);
  padding-left: 18rpx;
  margin: 10rpx 0;
  color: var(--ink-soft);
}

.md-code {
  background: var(--paper2);
  border: 3rpx solid var(--line);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  margin: 12rpx 0;
}

.md-code-text {
  font-family: Consolas, Monaco, monospace;
  font-size: 25rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}
