/* pages/knowledgeGraph/knowledgeGraph.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

.nav-icon {
  width: 36rpx;
  height: 36rpx;
}

.star-on {
  color: var(--hl);
}

.loading-tip {
  text-align: center;
  color: var(--gray);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* ========== 概览模式 · 总考点页面 ========== */
.kp-scroll-view {
  height: calc(100vh - 180rpx);
}

/* 顶部统计栏 */
.kp-stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 20rpx 32rpx;
  padding: 24rpx 20rpx;
  background: var(--paper);
  border: 4rpx solid var(--line);
  border-radius: 32rpx 28rpx 34rpx 26rpx;
  box-shadow: var(--sh-sm);
}

.kp-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.kp-stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--green-deep);
  line-height: 1.2;
}

.kp-stat-progress {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--green-accent);
  line-height: 1.2;
}

.kp-stat-label {
  font-size: 22rpx;
  color: var(--gray);
}

.kp-stat-divider {
  width: 3rpx;
  height: 60rpx;
  background: var(--gray-line);
  border-radius: 2rpx;
}

/* 课程滑动选项卡 */
.course-tabs-scroller {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.course-tabs {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 32rpx 16rpx;
}

.course-tab {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 16rpx 32rpx;
  background: var(--paper);
  border: 3rpx solid var(--gray-line);
  border-radius: 24rpx 20rpx 26rpx 18rpx;
  transition: all 0.2s;
}

.course-tab.active {
  background: var(--green-accent);
  border-color: var(--green-deep);
  box-shadow: var(--sh-green);
}

.tab-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.2;
}

.course-tab.active .tab-title {
  color: #fff;
}

.tab-stats {
  font-size: 20rpx;
  color: var(--gray);
}

.course-tab.active .tab-stats {
  color: rgba(255, 255, 255, 0.85);
}

.tab-done {
  font-weight: 700;
}

/* 知识点列表区域 */
.kp-list-section {
  padding: 0 32rpx 120rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 20rpx;
  margin-top: 8rpx;
}

.section-header .title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

.section-header .sub-title {
  font-size: 24rpx;
  color: var(--gray);
}

/* 考点卡片 */
.kp-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.kp-card {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  background: var(--paper);
  border: 4rpx solid var(--line);
  border-radius: 32rpx 28rpx 34rpx 26rpx;
  box-shadow: var(--sh-sm);
  transition: transform 0.12s, box-shadow 0.12s;
}

.kp-card.card-hover {
  transform: translate(3rpx, 3rpx);
  box-shadow: 0 0 0 var(--ink);
}

.kp-card.card-done {
  border-color: var(--green-accent);
  background: var(--green-soft);
}

.card-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-soft2);
  border-radius: 50%;
}

.card-done .card-icon {
  background: var(--green-accent);
}

.card-icon .icon {
  width: 36rpx;
  height: 36rpx;
}

.card-done .card-icon .icon {
  filter: brightness(0) invert(1);
}

.card-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.4;
  flex: 1;
  min-width: 0;
}

.card-badge {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--gray);
  background: var(--bg);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.card-badge.badge-done {
  background: var(--green-accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  padding: 0;
  border-radius: 50%;
}

.card-badge .icon {
  width: 24rpx;
  height: 24rpx;
}

.card-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.card-tags .tag {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--green-deep);
  background: var(--green-soft);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* ========== 画布缩放漫游区域 ========== */
.kg-area {
  width: 100%;
  height: calc(100vh - 280rpx);
  position: relative;
  overflow: hidden;
}

.kg-view {
  position: relative;
  transform-origin: 0 0;
  will-change: transform;
}

/* ========== 连线 ========== */
.kg-line {
  position: absolute;
  height: 3rpx;
  background: var(--gray-line);
  transform-origin: 0 50%;
  z-index: 1;
  border-radius: 2rpx;
  pointer-events: none; /* 防止连线拦截节点触摸事件 */
}

/* 中心考点→第一层子节点：加粗连线 */
.kg-line.thick {
  height: 6rpx;
  background: var(--green-deep);
  opacity: 0.35;
}

/* ========== 根节点 ========== */
.kg-root {
  position: absolute;
  z-index: 3;
}

.kg-root-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 300rpx;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  background: var(--green-accent);
  border: 4rpx solid var(--line);
  border-radius: 28rpx 24rpx 30rpx 26rpx;
  box-shadow: var(--sh-green);
}

.kg-root-icon {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 50%;
}

.kg-root-icon .icon {
  width: 36rpx;
  height: 36rpx;
}

.kg-root-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.kg-root-title {
  font-size: 27rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.3;
}

.kg-root-desc {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kg-root-go {
  flex-shrink: 0;
}

.kg-root-go .icon {
  width: 32rpx;
  height: 32rpx;
}

/* ========== 子知识点节点 ========== */
.kg-node {
  position: absolute;
  width: 220rpx;
  min-height: 128rpx;
  z-index: 2;
  transition: opacity 0.2s;
}

.kg-node.selected {
  z-index: 10;
}

.kg-node-card {
  display: flex;
  align-items: stretch;
  min-height: 128rpx;
  border: 3rpx solid var(--line);
  border-radius: 22rpx 18rpx 24rpx 16rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  overflow: hidden;
}

/* 已掌握节点 */
.kg-done .kg-node-card {
  border-color: var(--green-accent);
  background: var(--green-soft);
}

/* 选中节点高亮 */
.kg-node.selected .kg-node-card {
  border-color: var(--green-deep);
  border-width: 4rpx;
  box-shadow: 0 0 0 4rpx rgba(95, 184, 148, 0.25), var(--sh);
}

/* 状态标识圆 */
.kg-node-status {
  flex-shrink: 0;
  width: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-soft2);
}

.kg-done .kg-node-status {
  background: var(--green-accent);
}

.kg-node-status .icon {
  width: 28rpx;
  height: 28rpx;
}

.kg-node-num {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--ink-soft);
}

/* 节点内容区 */
.kg-node-body {
  flex: 1;
  min-width: 0;
  padding: 16rpx 16rpx 14rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.kg-node-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.kg-node-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

/* 难度指示器 */
.kg-diff {
  display: flex;
  gap: 4rpx;
  align-items: center;
}

.kg-diff-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--gray-line);
}

.kg-diff-dot.on {
  background: var(--green-accent);
}

/* 子节点数量 */
.kg-child-count {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--gray);
  background: var(--bg);
  padding: 2rpx 8rpx;
  border-radius: 20rpx;
}

/* 课程标识 */
.kg-course-tag {
  margin-left: auto;
}

.kg-course-tag .icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
}

/* ========== 顶部工具栏 ========== */
.kg-toolbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 36rpx;
  background: var(--paper);
  border-top: 4rpx solid var(--line);
  z-index: 20;
}

.kg-stat-mini {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.kg-stat-num {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--green-deep);
}

.kg-stat-label {
  font-size: 22rpx;
  color: var(--gray);
}

.kg-scale-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--gray);
  background: var(--bg);
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

.kg-toolbar-btns {
  display: flex;
  gap: 16rpx;
}

.kg-tool-btn {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-soft);
  padding: 10rpx 24rpx;
  border: 3rpx solid var(--gray-line);
  border-radius: 24rpx;
  background: var(--paper);
}

.kg-tool-btn:active {
  background: var(--green-soft);
}

/* ========== 详情面板 ========== */
.kg-detail-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(30, 38, 33, 0.4);
  z-index: 100;
}

.kg-detail-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--paper);
  border-top: 4rpx solid var(--line);
  border-radius: 40rpx 40rpx 0 0;
  max-height: 70vh;
  display: flex;
  flex-direction: column;
  animation: kg-slide-up 0.25s ease-out;
}

@keyframes kg-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* 详情头部 */
.kg-detail-header {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 3rpx solid var(--gray-line);
}

.kg-detail-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--green-soft);
  border-radius: 50%;
}

.kg-detail-icon .icon {
  width: 40rpx;
  height: 40rpx;
}

.kg-detail-title-wrap {
  flex: 1;
  min-width: 0;
}

.kg-detail-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  line-height: 1.4;
}

.kg-detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.kg-tag {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--green-deep);
  background: var(--green-soft);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.kg-detail-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.kg-detail-close .icon {
  width: 36rpx;
  height: 36rpx;
}

/* 详情内容区 */
.kg-detail-scroll {
  flex: 1;
  max-height: 400rpx;
  padding: 20rpx 32rpx;
}

.kg-detail-section {
  margin-bottom: 24rpx;
}

.kg-detail-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--gray);
  margin-bottom: 8rpx;
}

.kg-detail-desc {
  font-size: 27rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}

.kg-diff-lg {
  gap: 6rpx;
}

.kg-diff-lg .kg-diff-dot {
  width: 14rpx;
  height: 14rpx;
}

.kg-diff-text {
  font-size: 22rpx;
  color: var(--gray);
  margin-left: 8rpx;
}

/* 关联课程列表 */
.kg-lesson-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.kg-lesson-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 20rpx;
  background: var(--green-soft);
  border-radius: 20rpx;
}

.kg-lesson-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.kg-lesson-title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}

.kg-detail-prereq {
  font-size: 25rpx;
  color: var(--ink-soft);
}

/* 详情底部操作 */
.kg-detail-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx 36rpx;
  border-top: 3rpx solid var(--gray-line);
}

.kg-detail-btn {
  flex: 1;
  font-size: 27rpx;
  padding: 20rpx 0;
}

.kg-detail-btn .icon {
  width: 32rpx;
  height: 32rpx;
}
