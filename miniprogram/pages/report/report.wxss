/* pages/report/report.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

.nav-icon {
  width: 36rpx;
  height: 36rpx;
}

.demo-tip {
  border: 3rpx dashed var(--gray-line);
  border-radius: 24rpx;
  background: var(--hl);
  color: var(--ink-soft);
  font-size: 23rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 8rpx;
}

.loading-tip {
  text-align: center;
  color: var(--gray);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 核心指标 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 12rpx;
}

.stat-card {
  width: calc(50% - 10rpx);
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 26rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.stat-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  border: 3rpx solid var(--line);
  background: var(--green-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon-wrap .icon {
  width: 34rpx;
  height: 34rpx;
}

.stat-num-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.stat-num {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--green-deep);
}

.stat-unit {
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

.stat-label {
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

/* 本周分布 */
.week-card {
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 32rpx 24rpx 20rpx;
}

.week-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.week-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.week-count {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--green-deep);
}

.week-bar-wrap {
  height: 190rpx;
  display: flex;
  align-items: flex-end;
}

.week-bar {
  width: 36rpx;
  min-height: 8rpx;
  background: var(--green);
  border: 3rpx solid var(--line);
  border-radius: 14rpx;
}

.week-label {
  font-size: 23rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

/* 章节掌握度 */
.chapter-card {
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 12rpx 28rpx;
}

.chapter-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx dashed var(--gray-line);
}

.chapter-row:last-child {
  border-bottom: none;
}

.chapter-name {
  flex: 0 0 170rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.chapter-bar-wrap {
  flex: 1;
  height: 24rpx;
  border: 3rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--paper2);
  overflow: hidden;
}

.chapter-bar {
  height: 100%;
  background: var(--gray-line);
  border-radius: 8rpx;
}

.chapter-bar.mid {
  background: var(--green);
}

.chapter-bar.high {
  background: var(--green-deep);
}

.chapter-pct {
  flex: 0 0 70rpx;
  text-align: right;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--green-deep);
}
