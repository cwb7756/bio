/* pages/report/report.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

.nav-icon {
  width: 36rpx;
  height: 36rpx;
}

.loading-tip {
  text-align: center;
  color: var(--gray);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 核心指标：图标+标签横排，数字突出，整体更紧凑 */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 4rpx;
}

.stat-card {
  width: calc(50% - 10rpx);
  border: 4rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 22rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.stat-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.stat-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  border: 3rpx solid var(--line);
  background: var(--green-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon-wrap .icon {
  width: 30rpx;
  height: 30rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stat-num-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  padding-left: 4rpx;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--green-deep);
  line-height: 1.1;
}

.stat-unit {
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

/* 空状态引导 */
.empty-card {
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  margin-top: 28rpx;
  padding: 48rpx 40rpx 52rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-img {
  width: 200rpx;
  height: 200rpx;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 20rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--ink-soft);
  line-height: 1.6;
  margin-top: 12rpx;
  white-space: pre-line;
}

.empty-btn {
  margin-top: 32rpx;
  padding: 20rpx 44rpx;
  font-size: 28rpx;
}

.empty-btn-icon {
  width: 30rpx;
  height: 30rpx;
}

/* 近7天分布 */
.week-card {
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 32rpx 20rpx 20rpx;
}

.week-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
}

.week-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.week-count {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--green-deep);
  min-height: 30rpx;
  line-height: 30rpx;
}

.week-bar-wrap {
  height: 190rpx;
  display: flex;
  align-items: flex-end;
}

.week-bar {
  width: 40rpx;
  min-height: 10rpx;
  background: var(--green);
  border: 3rpx solid var(--line);
  border-radius: 14rpx;
}

.week-bar.zero {
  background: var(--paper2);
  border-color: var(--gray-line);
}

.week-label {
  font-size: 23rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

/* 章节掌握度 */
.chapter-card {
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 8rpx 24rpx;
}

.chapter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx dashed var(--gray-line);
}

.chapter-row:last-child {
  border-bottom: none;
}

.chapter-name {
  flex: 0 0 156rpx;
  font-size: 25rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
}

.chapter-bar-wrap {
  flex: 1;
  height: 22rpx;
  border: 3rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--paper2);
  overflow: hidden;
}

.chapter-bar {
  height: 100%;
  background: var(--gray-line);
  border-radius: 8rpx;
}

.chapter-bar.mid {
  background: var(--green);
}

.chapter-bar.high {
  background: var(--green-deep);
}

.chapter-pct {
  flex: 0 0 64rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--green-deep);
}

.chapter-pct.zero {
  color: var(--gray);
}
