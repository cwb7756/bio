<!--pages/report/report.wxml-->
<view class="page-container">
  <view class="bg-dots"></view>

  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <!-- 导航栏 -->
  <view class="navbar">
    <view class="icon-btn" bindtap="goBack">
      <view class="icon ic-back nav-icon"></view>
    </view>
    <text class="nav-t">学习报告</text>
    <view class="icon-btn" style="visibility: hidden;"></view>
  </view>

  <view class="page-body">
    <view class="page-pad">
      <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

      <block wx:else>
        <!-- 核心指标 -->
        <view class="stats-grid">
          <view wx:for="{{stats}}" wx:key="label" class="stat-card">
            <view class="stat-head">
              <view class="stat-icon-wrap">
                <view class="icon {{item.icon}}"></view>
              </view>
              <text class="stat-label">{{item.label}}</text>
            </view>
            <view class="stat-num-row">
              <text class="stat-num">{{item.num}}</text>
              <text class="stat-unit">{{item.unit}}</text>
            </view>
          </view>
        </view>

        <!-- 无学习记录：空状态引导 -->
        <view wx:if="{{!hasData}}" class="empty-card">
          <image class="empty-img" src="/images/cat-study.png" mode="aspectFit"></image>
          <text class="empty-title">还没有学习数据</text>
          <text class="empty-desc">完成一节课或刷几道题，\n这里就会生成你的专属学习报告</text>
          <view class="btn deep empty-btn" bindtap="goStudy">
            <text>去学习</text>
            <view class="icon ic-arrow-right empty-btn-icon"></view>
          </view>
        </view>

        <block wx:else>
          <!-- 近7天学习分布 -->
          <view class="sec-title">
            <text class="u">近7天学习分布</text>
          </view>
          <view class="week-card">
            <view class="week-chart">
              <view wx:for="{{week}}" wx:key="label" class="week-col">
                <text class="week-count {{item.count === 0 ? 'zero' : ''}}">{{item.count > 0 ? item.count : ''}}</text>
                <view class="week-bar-wrap">
                  <view class="week-bar {{item.count === 0 ? 'zero' : ''}}" style="height: {{item.count / weekMax * 180}}rpx;"></view>
                </view>
                <text class="week-label">{{item.label}}</text>
              </view>
            </view>
          </view>

          <!-- 章节掌握度 -->
          <view class="sec-title">
            <text class="u">章节掌握度</text>
          </view>
          <view class="chapter-card">
            <view wx:for="{{chapters}}" wx:key="chapter" class="chapter-row">
              <text class="chapter-name">{{item.chapter}}</text>
              <view class="chapter-bar-wrap">
                <view class="chapter-bar {{item.mastery >= 80 ? 'high' : item.mastery >= 40 ? 'mid' : ''}}" style="width: {{item.mastery}}%;"></view>
              </view>
              <text class="chapter-pct {{item.mastery === 0 ? 'zero' : ''}}">{{item.mastery}}%</text>
            </view>
          </view>
        </block>
      </block>

      <view style="height: 60rpx;"></view>
    </view>
  </view>
</view>
