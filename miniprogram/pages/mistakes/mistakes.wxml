<!--pages/mistakes/mistakes.wxml-->
<view class="page-container">
  <view class="bg-dots"></view>

  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <!-- 导航栏 -->
  <view class="navbar">
    <view class="icon-btn" bindtap="goBack">
      <view class="icon ic-back nav-icon"></view>
    </view>
    <text class="nav-t">错题本</text>
    <view class="nav-count" wx:if="{{!loading}}">{{searchValue ? '找到 ' + total + ' 题' : total + ' 题'}}</view>
    <view class="icon-btn" wx:else></view>
  </view>

  <view class="page-body">
    <view class="page-pad">
      <!-- 搜索栏 -->
      <view class="search mk-search">
        <view class="icon ic-search search-icon"></view>
        <input
          placeholder="搜索题干 / 章节 / 考点"
          value="{{searchValue}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
          confirm-type="search"
        />
        <view class="search-clear" catchtap="clearSearch" wx:if="{{searchValue}}">
          <view class="icon ic-close"></view>
        </view>
      </view>

      <!-- demo 提示 -->
      <view wx:if="{{isDemo && !loading && !searchValue}}" class="demo-tip">
        <text>示例数据 · 刷题后答错的题目会自动收录到这里</text>
      </view>

      <view wx:if="{{loading}}" class="loading-tip">加载中...</view>

      <block wx:else>
        <!-- 错题卡片 -->
        <view wx:for="{{mistakes}}" wx:key="_id" class="mk-card" id="mk-{{item._id}}">
          <view class="mk-head">
            <view class="chip mk-chip">{{item.chapter}} · {{item.topic}}</view>
            <view class="mk-del" data-id="{{item._id}}" catchtap="removeMistake" wx:if="{{!item.isDemo}}">
              <view class="icon ic-close"></view>
            </view>
          </view>

          <text class="mk-stem">{{item.stem}}</text>

          <!-- 选项 -->
          <view class="mk-options">
            <view
              wx:for="{{item.options}}"
              wx:for-item="opt"
              wx:key="key"
              class="mk-opt {{opt.key === item.answer ? 'opt-right' : ''}} {{opt.key === item.userAnswer && opt.key !== item.answer ? 'opt-wrong' : ''}}"
            >
              <view class="mk-key">{{opt.key}}</view>
              <text class="mk-opt-text">{{opt.text}}</text>
              <view class="icon ic-check-circle mk-res" wx:if="{{opt.key === item.answer}}"></view>
              <view class="icon ic-close-circle mk-res" wx:if="{{opt.key === item.userAnswer && opt.key !== item.answer}}"></view>
            </view>
          </view>

          <!-- 解析 -->
          <view class="mk-foot" data-id="{{item._id}}" bindtap="toggleExplain">
            <text class="mk-toggle">{{expanded[item._id] ? '收起解析' : '查看解析'}}</text>
            <view class="icon ic-chevron-right mk-toggle-icon {{expanded[item._id] ? 'rot' : ''}}"></view>
          </view>
          <view class="mk-explain" wx:if="{{expanded[item._id]}}">
            <text>{{item.explanation}}</text>
          </view>
          <view class="mk-add-nb" catchtap="addToNotebook" data-id="{{item._id}}">
            <view class="icon ic-pen"></view>
            <text>加入我的笔记本</text>
          </view>
        </view>

        <!-- 空态 -->
        <view wx:if="{{mistakes.length === 0}}" class="empty-box">
          <text class="empty-title">{{searchValue ? '未找到相关错题' : '错题本空空如也'}}</text>
          <text class="empty-desc">{{searchValue ? '换个关键词试试，或清空搜索查看全部' : '去刷题，答错的题目会自动收录进来'}}</text>
          <view class="btn ghost" bindtap="clearSearch" wx:if="{{searchValue}}">清空搜索</view>
          <view class="btn" bindtap="goQuiz" wx:else>去刷题</view>
        </view>
      </block>

      <view style="height: 60rpx;"></view>
    </view>
  </view>
</view>
