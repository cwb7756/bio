/* pages/achievements/achievements.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

.nav-icon {
  width: 36rpx;
  height: 36rpx;
}

.demo-tip {
  border: 3rpx dashed var(--gray-line);
  border-radius: 24rpx;
  background: var(--hl);
  color: var(--ink-soft);
  font-size: 23rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 8rpx;
}

.loading-tip {
  text-align: center;
  color: var(--gray);
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* 总览 */
.overview-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FFF9E6, var(--hl));
  box-shadow: var(--sh);
  padding: 28rpx;
  margin-top: 12rpx;
}

.overview-icon {
  flex: 0 0 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
}

.overview-icon .icon {
  width: 46rpx;
  height: 46rpx;
}

.overview-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.overview-title {
  font-size: 32rpx;
  font-weight: 800;
}

.overview-bar-wrap {
  height: 24rpx;
  border: 3rpx solid var(--line);
  border-radius: 14rpx;
  background: var(--paper);
  overflow: hidden;
}

.overview-bar {
  height: 100%;
  background: var(--green);
  border-radius: 8rpx;
}

/* 成就网格 */
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 28rpx;
}

.ach-card {
  width: calc(50% - 10rpx);
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.ach-card.locked {
  opacity: .72;
}

.ach-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  background: var(--hl);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ach-card.locked .ach-icon-wrap {
  background: var(--green-soft);
}

.ach-icon-wrap .icon {
  width: 44rpx;
  height: 44rpx;
}

.ach-name {
  font-size: 28rpx;
  font-weight: 800;
}

.ach-desc {
  font-size: 22rpx;
  color: var(--gray);
  text-align: center;
  min-height: 56rpx;
}

.ach-progress {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  align-items: center;
}

.ach-bar-wrap {
  width: 100%;
  height: 18rpx;
  border: 2rpx solid var(--line);
  border-radius: 12rpx;
  background: var(--paper2);
  overflow: hidden;
}

.ach-bar {
  height: 100%;
  background: var(--green);
}

.ach-pct {
  font-size: 21rpx;
  color: var(--gray);
  font-weight: 700;
}

.ach-done {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--green-deep);
}

.ach-done .icon {
  width: 30rpx;
  height: 30rpx;
}
