<!--pages/aiClassroom/aiClassroom.wxml-->
<view class="page-container">
  <view class="bg-dots"></view>

  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶栏 -->
  <view class="cl-navbar">
    <view class="icon-btn" bindtap="onNavBack" hover-class="cl-btn-hover">
      <view class="icon ic-back"></view>
    </view>
    <text class="cl-nav-title">{{phase === 'playing' ? coursewareTitle : 'AI课堂'}}</text>
    <view wx:if="{{phase === 'playing'}}" class="cl-page-badge">{{current + 1}}/{{scenes.length}}</view>
    <view wx:else class="cl-nav-placeholder"></view>
  </view>

  <!-- ===== input 态 ===== -->
  <scroll-view wx:if="{{phase === 'input'}}" scroll-y class="cl-body">
    <view class="page-pad">
      <view class="page-header">
        <text class="page-title">AI课堂</text>
        <text class="page-subtitle">输入问题，AI老师为你生成有声课件</text>
      </view>

      <!-- 输入卡片 -->
      <view class="cl-input-card">
        <textarea class="cl-textarea" value="{{inputValue}}" bindinput="onInput" placeholder="例如：什么是光合作用？" auto-height maxlength="200" />
        <view class="cl-input-actions">
          <text class="cl-input-count">{{inputValue.length}}/200</text>
          <view class="cl-actions-right">
            <!-- 音色选择器 -->
            <view class="cl-voice-selector" bindtap="onShowVoiceSelector">
              <view class="icon ic-volume"></view>
              <text>{{currentVoiceName}}</text>
              <view class="icon ic-chevron-down"></view>
            </view>
            <view class="btn deep cl-gen-btn" bindtap="onStartOutline">生成课件</view>
          </view>
        </view>
      </view>

      <!-- 推荐主题 -->
      <view class="cl-sugg">
        <view class="chip cl-sugg-chip" wx:for="{{suggestions}}" wx:key="*this" data-text="{{item}}" bindtap="onTapSuggestion">{{item}}</view>
      </view>

      <!-- 历史课件 -->
      <block wx:if="{{historyList.length}}">
        <view class="sec-title"><text class="u">历史课件</text></view>
        <view class="cl-history-item" wx:for="{{historyList}}" wx:key="_id" data-id="{{item._id}}" bindtap="onTapHistory" bindlongpress="onLongPressHistory" hover-class="cl-history-hover">
          <view class="icon ic-history cl-history-icon"></view>
          <view class="cl-history-text">
            <text class="cl-history-title">{{item.title}}</text>
            <text class="cl-history-meta">{{item.sceneCount}}节 · {{item.timeText}}</text>
          </view>
          <view class="icon ic-chevron-right"></view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- 音色选择弹窗 -->
  <view wx:if="{{showVoiceSelector}}" class="cl-voice-mask" bindtap="onHideVoiceSelector"></view>
  <view wx:if="{{showVoiceSelector}}" class="cl-voice-popup">
    <text class="cl-voice-title">选择 TTS 音色</text>
    <view class="cl-voice-options">
      <view class="cl-voice-item {{currentVoice === item.id ? 'cl-voice-active' : ''}}" 
            data-id="{{item.id}}" 
            bindtap="onVoiceChange"
            wx:for="{{voiceOptions}}" 
            wx:key="id">
        <text>{{item.name}}</text>
        <view wx:if="{{currentVoice === item.id}}" class="icon ic-check-circle"></view>
      </view>
    </view>
  </view>

  <!-- ===== outline 态 ===== -->
  <scroll-view wx:if="{{phase === 'outline'}}" scroll-y class="cl-body">
    <view class="page-pad">
      <view class="page-header">
        <text class="page-title">课件大纲</text>
        <text class="page-subtitle">{{outlineLoading ? '大纲正在逐节生成中' : '确认或调整章节，然后开始生成'}}</text>
      </view>
  
      <!-- 大纲生成中：动态等待 + 流式章节 -->
      <block wx:if="{{outlineLoading}}">
        <view class="cl-loading">
          <view class="cl-orb">
            <view class="cl-orb-ring"></view>
            <view class="icon ic-bot cl-loading-icon"></view>
          </view>
          <view class="cl-loading-text">
            <text>{{outlineTip}}</text><text class="cl-adot">.</text><text class="cl-adot cl-adot-2">.</text><text class="cl-adot cl-adot-3">.</text>
          </view>
        </view>
  
        <!-- 流式大纲：解析出一节立即上屏 -->
        <view wx:if="{{outlineTitle}}" class="cl-outline-title cl-pop-in">{{outlineTitle}}</view>
        <view class="cl-sec-card cl-pop-in" wx:for="{{sections}}" wx:key="index">
          <view class="cl-sec-index">{{index + 1}}</view>
          <view class="cl-sec-main">
            <text class="cl-sec-static-title">{{item.title}}</text>
            <view class="cl-sec-meta">
              <text class="cl-sec-type cl-type-{{item.sceneType}}">{{typeLabels[item.sceneType]}}</text>
              <text class="cl-sec-goal">{{item.goal}}</text>
            </view>
          </view>
        </view>
        <!-- 骨架占位：后续章节生成中 -->
        <view class="cl-sec-card cl-sec-skeleton">
          <view class="cl-skeleton-circle"></view>
          <view class="cl-skeleton-body">
            <view class="cl-skeleton-line cl-w60"></view>
            <view class="cl-skeleton-line cl-w40"></view>
          </view>
        </view>
      </block>
  
      <!-- 大纲就绪：可编辑确认 -->
      <block wx:else>
        <view class="cl-outline-title cl-pop-in">{{outlineTitle}}</view>
        <view class="cl-sec-card cl-pop-in" style="animation-delay: {{index * 70}}ms;" wx:for="{{sections}}" wx:key="index">
          <view class="cl-sec-index">{{index + 1}}</view>
          <view class="cl-sec-main">
            <input class="cl-sec-input" value="{{item.title}}" data-index="{{index}}" bindinput="onEditSection" maxlength="20" />
            <view class="cl-sec-meta">
              <text class="cl-sec-type cl-type-{{item.sceneType}}">{{typeLabels[item.sceneType]}}</text>
              <text class="cl-sec-goal">{{item.goal}}</text>
            </view>
          </view>
          <view class="cl-sec-del" data-index="{{index}}" bindtap="onDeleteSection">
            <view class="icon ic-close"></view>
          </view>
        </view>
  
        <view class="cl-outline-actions cl-pop-in" style="animation-delay: {{sections.length * 70}}ms;">
          <view class="btn ghost" bindtap="onStartOutline">重新生成</view>
          <view class="btn deep" bindtap="onConfirmOutline">开始生成课件</view>
        </view>
      </block>
    </view>
  </scroll-view>

  <!-- ===== generating 态 ===== -->
  <view wx:if="{{phase === 'generating'}}" class="cl-body cl-center-body">
    <view class="cl-gen-card">
      <view class="cl-orb">
        <view class="cl-orb-ring"></view>
        <view class="icon ic-bot cl-gen-icon"></view>
      </view>
      <text class="cl-gen-title">AI 老师正在制作课件</text>
      <text class="cl-gen-progress-text">已完成 {{genDoneList.length}} / {{genTotal}} 节</text>
      <text wx:if="{{genStage}}" class="cl-gen-stage">{{genStage}}</text>
      <view class="cl-progress">
        <view class="cl-progress-bar" style="width: {{genProgress}};">
          <view class="cl-progress-shine"></view>
        </view>
      </view>
      <text class="cl-gen-tip {{tipAlt ? 'cl-tip-a' : 'cl-tip-b'}}">{{genTip}}</text>
  
      <!-- 章节清单：已完成打勾 / 生成中转圈 / 待生成置灰，逐节跳动 -->
      <view class="cl-gen-list" wx:if="{{genList.length}}">
        <view class="cl-gen-item cl-gen-item-{{item.status}} {{item.status === 'done' ? 'cl-pop-in' : ''}}" wx:for="{{genList}}" wx:key="index">
          <view wx:if="{{item.status === 'done'}}" class="icon ic-check-circle cl-gen-check"></view>
          <view wx:elif="{{item.status === 'doing'}}" class="cl-gen-spinner"></view>
          <view wx:else class="cl-gen-todo"></view>
          <text class="cl-gen-item-title">{{item.title}}</text>
          <text class="cl-sec-type cl-type-{{item.sceneType}}">{{typeLabels[item.sceneType]}}</text>
        </view>
      </view>
      <!-- 兜底：无大纲快照时仅列出已完成章节 -->
      <view class="cl-gen-list" wx:elif="{{genDoneList.length}}">
        <view class="cl-gen-item cl-pop-in" wx:for="{{genDoneList}}" wx:key="index">
          <view class="icon ic-check-circle cl-gen-check"></view>
          <text class="cl-gen-item-title">{{item.title}}</text>
          <text class="cl-sec-type cl-type-{{item.sceneType}}">{{typeLabels[item.sceneType]}}</text>
        </view>
      </view>
  
      <view class="cl-gen-actions">
        <view class="btn ghost" bindtap="onAbortGenerate">取消</view>
      </view>
    </view>
  </view>

  <!-- ===== playing 态 ===== -->
  <block wx:if="{{phase === 'playing'}}">
    <scroll-view scroll-y class="cl-stage" enhanced show-scrollbar="{{false}}">
      <block wx:if="{{currentScene}}">

        <!-- cover 封面 -->
        <view wx:if="{{currentScene.type === 'cover'}}" class="cl-cover">
          <view class="cl-cover-badge">AI 课件</view>
          <text class="cl-cover-title">{{currentScene.title}}</text>
          <text class="cl-cover-sub">{{currentScene.subtitle}}</text>
        </view>

        <!-- concept 概念页 -->
        <view wx:if="{{currentScene.type === 'concept'}}" class="cl-scene">
          <text class="cl-scene-title">{{currentScene.title}}</text>
          <block wx:for="{{currentScene.blocks}}" wx:for-item="b" wx:key="index">
            <text wx:if="{{b.kind === 'paragraph'}}" class="cl-para">{{b.text}}</text>
            <view wx:if="{{b.kind === 'bullets'}}" class="cl-bullets">
              <view class="cl-bullet" wx:for="{{b.items}}" wx:for-item="it" wx:key="*this">
                <view class="cl-bullet-dot"></view>
                <text class="cl-bullet-text">{{it}}</text>
              </view>
            </view>
            <view wx:if="{{b.kind === 'steps'}}" class="cl-steps">
              <view class="cl-step" wx:for="{{b.items}}" wx:for-item="it" wx:key="*this">
                <view class="cl-step-num">{{index + 1}}</view>
                <text class="cl-step-text">{{it}}</text>
              </view>
            </view>
            <view wx:if="{{b.kind === 'keypoint'}}" class="cl-keypoint">
              <text class="cl-keypoint-label">{{b.label}}</text>
              <text class="cl-keypoint-text">{{b.text}}</text>
            </view>
            <view wx:if="{{b.kind === 'compare'}}" class="cl-compare">
              <view class="cl-compare-col">
                <text class="cl-compare-head">{{b.left.title}}</text>
                <text class="cl-compare-item" wx:for="{{b.left.items}}" wx:for-item="it" wx:key="*this">{{it}}</text>
              </view>
              <view class="cl-compare-col">
                <text class="cl-compare-head">{{b.right.title}}</text>
                <text class="cl-compare-item" wx:for="{{b.right.items}}" wx:for-item="it" wx:key="*this">{{it}}</text>
              </view>
            </view>
            <view wx:if="{{b.kind === 'table'}}" class="cl-table">
              <view class="cl-table-row cl-table-head">
                <text class="cl-table-cell" wx:for="{{b.head}}" wx:for-item="h" wx:key="*this">{{h}}</text>
              </view>
              <view class="cl-table-row" wx:for="{{b.rows}}" wx:for-item="row" wx:key="index">
                <text class="cl-table-cell" wx:for="{{row}}" wx:for-item="cell" wx:key="*this">{{cell}}</text>
              </view>
            </view>
          </block>
        </view>

        <!-- diagram 图解页 -->
        <view wx:if="{{currentScene.type === 'diagram'}}" class="cl-scene">
          <text class="cl-scene-title">{{currentScene.title}}</text>
          <view class="cl-diagram">
            <image class="cl-diagram-img" src="{{currentScene.imageFileId}}" mode="aspectFit" />
            <text wx:if="{{currentScene.caption}}" class="cl-diagram-caption">{{currentScene.caption}}</text>
          </view>
        </view>

        <!-- sim 分帧动画页 -->
        <view wx:if="{{currentScene.type === 'sim'}}" class="cl-scene">
          <text class="cl-scene-title">{{currentScene.title}}</text>
          <view class="cl-sim">
            <image class="cl-sim-frame" src="{{currentFrame.imageFileId}}" mode="aspectFit" />
            <view class="cl-sim-caption-row">
              <text class="cl-sim-caption">{{currentFrame.caption}}</text>
              <text class="cl-sim-count">{{frameIndex + 1}}/{{currentScene.frames.length}}</text>
            </view>
            <view class="cl-sim-dots">
              <view wx:for="{{currentScene.frames}}" wx:key="index" data-index="{{index}}" bindtap="onTapFrameDot" class="cl-sim-dot {{frameIndex === index ? 'cl-sim-dot-on' : ''}}"></view>
            </view>
          </view>
        </view>

        <!-- quiz 小测页 -->
        <view wx:if="{{currentScene.type === 'quiz'}}" class="cl-scene">
          <text class="cl-scene-title">{{currentScene.title}}</text>
          <view class="cl-quiz-q">{{currentScene.question}}</view>
          <view wx:for="{{currentScene.options}}" wx:key="key" data-key="{{item.key}}" bindtap="onPickOption"
            class="cl-quiz-opt {{quizPicked && item.key === currentScene.answer ? 'cl-quiz-right' : ''}} {{quizPicked === item.key && item.key !== currentScene.answer ? 'cl-quiz-wrong' : ''}}">
            <text class="cl-quiz-key">{{item.key}}</text>
            <text class="cl-quiz-text">{{item.text}}</text>
          </view>
          <view wx:if="{{quizPicked}}" class="cl-quiz-result">
            <text class="cl-quiz-verdict {{quizPicked === currentScene.answer ? 'cl-quiz-verdict-right' : 'cl-quiz-verdict-wrong'}}">{{quizPicked === currentScene.answer ? '回答正确' : '正确答案：' + currentScene.answer}}</text>
            <text class="cl-quiz-expl">{{currentScene.explanation}}</text>
          </view>
        </view>

        <!-- summary 总结页 -->
        <view wx:if="{{currentScene.type === 'summary'}}" class="cl-scene">
          <text class="cl-scene-title">{{currentScene.title}}</text>
          <view class="cl-summary-point" wx:for="{{currentScene.points}}" wx:key="*this">
            <view class="icon ic-check-circle cl-summary-icon"></view>
            <text class="cl-summary-text">{{item}}</text>
          </view>
        </view>

        <!-- 末页：完成课程按钮 -->
        <view wx:if="{{isLastScene && !showComplete}}" class="cl-finish-wrap">
          <view class="btn deep cl-finish-btn-lg" bindtap="onFinishCourse">完成课程</view>
        </view>

        <!-- 底部留白，避免被字幕/控制栏遮挡 -->
        <view class="cl-stage-gap"></view>
      </block>
    </scroll-view>

    <!-- 字幕条 -->
    <view wx:if="{{subtitle}}" class="cl-subtitle" bindtap="onToggleSubtitle">
      <text wx:if="{{showSubtitle}}" class="cl-subtitle-text">{{subtitle}}</text>
      <view class="cl-subtitle-bar">
        <view class="icon ic-chevron-right cl-subtitle-arrow {{showSubtitle ? 'cl-arrow-up' : 'cl-arrow-down'}}"></view>
      </view>
    </view>

    <!-- 控制栏 -->
    <view class="cl-controls">
      <view class="cl-ctrl" bindtap="onPrevScene" hover-class="cl-ctrl-hover">
        <view class="icon ic-back"></view>
      </view>
      <view class="cl-ctrl cl-ctrl-main" bindtap="onTogglePlay" hover-class="cl-ctrl-hover">
        <view class="icon {{playing ? 'ic-pause' : 'ic-play'}}"></view>
      </view>
      <!-- 末页显示完成图标，非末页显示下一节图标；倒计时期间显示剩余秒数 -->
      <view class="cl-ctrl {{isLastScene ? 'cl-ctrl-done' : ''}}" bindtap="onNextScene" hover-class="cl-ctrl-hover">
        <text wx:if="{{!isLastScene && nextDwellCountdown !== null}}" class="cl-ctrl-countdown">{{nextDwellCountdown}}</text>
        <view wx:else class="icon {{isLastScene ? 'ic-check-circle-w' : 'ic-arrow-right'}}"></view>
      </view>
      <view class="cl-ctrl" bindtap="onReplay" hover-class="cl-ctrl-hover">
        <view class="icon ic-refresh"></view>
      </view>
      <view class="cl-ctrl cl-ctrl-auto {{autoPlay ? 'cl-ctrl-on' : ''}}" bindtap="onToggleAuto" hover-class="cl-ctrl-hover">
        <view class="icon ic-bolt"></view>
        <text class="cl-ctrl-label">自动</text>
      </view>
    </view>

    <!-- 课程完成遮罩 -->
    <view wx:if="{{showComplete}}" class="cl-complete-mask">
      <view class="cl-complete-card">
        <view class="icon ic-check-circle cl-complete-icon"></view>
        <text class="cl-complete-title">课程完成！</text>
        <text class="cl-complete-name">{{coursewareTitle}}</text>
        <text class="cl-complete-stats">共 {{scenes.length}} 节<block wx:if="{{quizTotal}}"> · 小测 {{quizRight}}/{{quizTotal}} 正确</block></text>
        <view class="cl-complete-actions">
          <view class="btn ghost" bindtap="onRestartCourse">再学一遍</view>
          <view class="btn deep" bindtap="onCompleteExit">完成课程</view>
        </view>
      </view>
    </view>
  </block>
</view>
