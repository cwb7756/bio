/* pages/aiClassroom/aiClassroom.wxss */

/* ---- 顶栏 ---- */
.cl-navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 36rpx 20rpx;
}

.cl-nav-title {
  flex: 1;
  margin: 0 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cl-nav-placeholder {
  width: 76rpx;
  flex-shrink: 0;
}

.cl-page-badge {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--green-deep);
  background: var(--green-soft);
  border: 3rpx solid var(--line);
  border-radius: 24rpx;
  padding: 4rpx 18rpx;
}

.cl-btn-hover {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.cl-body {
  flex: 1;
  height: 0;
}

.page-header {
  margin: 8rpx 4rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 26rpx;
  color: var(--ink-soft);
}

/* ---- input 态 ---- */
.cl-input-card {
  border: 4rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 28rpx;
}

.cl-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--ink);
}

.cl-input-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
}

.cl-input-count {
  font-size: 24rpx;
  color: var(--gray);
}

.cl-gen-btn {
  padding: 18rpx 40rpx;
}

.cl-sugg {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cl-sugg-chip {
  background: var(--paper2);
}

/* 历史课件 */
.cl-history-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

.cl-history-hover {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.cl-history-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.cl-history-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cl-history-title {
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cl-history-meta {
  font-size: 24rpx;
  color: var(--gray);
}

/* ---- outline 态 ---- */
.cl-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 120rpx 0;
}

.cl-loading-icon {
  width: 96rpx;
  height: 96rpx;
}

.cl-loading-text {
  font-size: 28rpx;
  color: var(--ink-soft);
}

.cl-outline-title {
  font-size: 38rpx;
  font-weight: 800;
  margin: 0 8rpx 28rpx;
}

.cl-sec-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 3rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

.cl-sec-index {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  border: 3rpx solid var(--line);
  border-radius: 50%;
  background: var(--green);
}

.cl-sec-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cl-sec-input {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  border-bottom: 2rpx dashed var(--gray-line);
  padding-bottom: 4rpx;
}

.cl-sec-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cl-sec-type {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--green-deep);
  background: var(--green-soft);
  border: 2rpx solid var(--green-accent);
  border-radius: 16rpx;
  padding: 0 12rpx;
  flex-shrink: 0;
}

.cl-type-sim {
  color: #8a6d1d;
  background: var(--hl);
  border-color: #d8b93a;
}

.cl-type-quiz {
  color: #4a6fa5;
  background: #e8eef7;
  border-color: #7f9cc9;
}

.cl-sec-goal {
  font-size: 24rpx;
  color: var(--gray);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cl-sec-del {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cl-sec-del .icon {
  width: 32rpx;
  height: 32rpx;
}

.cl-outline-actions {
  display: flex;
  gap: 22rpx;
  margin-top: 36rpx;
}

.cl-outline-actions .btn {
  flex: 1;
}

/* ---- generating 态 ---- */
.cl-center-body {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}

.cl-gen-card {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 4rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 48rpx 36rpx;
}

.cl-gen-icon {
  width: 96rpx;
  height: 96rpx;
}

.cl-gen-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 24rpx;
}

.cl-gen-progress-text {
  font-size: 26rpx;
  color: var(--ink-soft);
  margin-top: 12rpx;
}

.cl-gen-stage {
  font-size: 24rpx;
  color: var(--green-deep);
  margin-top: 8rpx;
}

.cl-progress {
  width: 100%;
  height: 20rpx;
  margin-top: 24rpx;
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--paper2);
  overflow: hidden;
}

.cl-progress-bar {
  height: 100%;
  background: var(--green);
  border-radius: 20rpx;
  transition: width .3s;
}

.cl-gen-list {
  width: 100%;
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.cl-gen-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.cl-gen-check {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.cl-gen-item-title {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cl-gen-actions {
  display: flex;
  gap: 22rpx;
  margin-top: 36rpx;
  width: 100%;
}

.cl-gen-actions .btn {
  flex: 1;
}

/* ---- playing 态 · 舞台 ---- */
.cl-stage {
  flex: 1;
  height: 0;
}

.cl-stage-gap {
  height: 40rpx;
}

.cl-scene {
  padding: 24rpx 36rpx;
  display: flex;
  flex-direction: column;
}

.cl-scene-title {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  margin-bottom: 28rpx;
}

/* cover */
.cl-cover {
  margin: 60rpx 36rpx 0;
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  border: 4rpx solid var(--line);
  border-radius: var(--r1);
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 60rpx 40rpx;
}

.cl-cover-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--green-deep);
  background: var(--green-soft);
  border: 3rpx solid var(--green-accent);
  border-radius: 24rpx;
  padding: 6rpx 24rpx;
}

.cl-cover-title {
  font-size: 52rpx;
  font-weight: 800;
  text-align: center;
  line-height: 1.35;
}

.cl-cover-sub {
  font-size: 28rpx;
  color: var(--ink-soft);
  text-align: center;
  line-height: 1.6;
}

/* concept blocks */
.cl-para {
  font-size: 30rpx;
  line-height: 1.75;
  margin-bottom: 24rpx;
}

.cl-bullets, .cl-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.cl-bullet {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
}

.cl-bullet-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--green-accent);
  border: 2rpx solid var(--line);
  flex-shrink: 0;
}

.cl-bullet-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.65;
}

.cl-step {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
}

.cl-step-num {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  border: 3rpx solid var(--line);
  border-radius: 50%;
  background: var(--green);
}

.cl-step-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.65;
}

.cl-keypoint {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 24rpx;
  padding: 24rpx 28rpx;
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--green-soft);
}

.cl-keypoint-label {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--green-deep);
}

.cl-keypoint-text {
  font-size: 30rpx;
  line-height: 1.65;
}

.cl-compare {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.cl-compare-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 22rpx;
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--paper2);
}

.cl-compare-head {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--green-deep);
  margin-bottom: 6rpx;
}

.cl-compare-item {
  font-size: 27rpx;
  line-height: 1.55;
}

.cl-table {
  border: 3rpx solid var(--line);
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.cl-table-row {
  display: flex;
  border-top: 2rpx solid var(--gray-line);
}

.cl-table-row:first-child {
  border-top: none;
}

.cl-table-head {
  background: var(--green-soft2);
}

.cl-table-cell {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.5;
  padding: 16rpx 18rpx;
  border-left: 2rpx solid var(--gray-line);
}

.cl-table-cell:first-child {
  border-left: none;
}

.cl-table-head .cl-table-cell {
  font-weight: 800;
}

/* diagram */
.cl-diagram {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

.cl-diagram-img {
  width: 100%;
  height: 480rpx;
}

.cl-diagram-caption {
  font-size: 25rpx;
  color: var(--ink-soft);
  text-align: center;
}

/* sim */
.cl-sim {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

.cl-sim-frame {
  width: 100%;
  height: 480rpx;
}

.cl-sim-caption-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cl-sim-caption {
  font-size: 30rpx;
  font-weight: 800;
}

.cl-sim-count {
  font-size: 24rpx;
  color: var(--gray);
  font-weight: 700;
}

.cl-sim-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.cl-sim-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 2rpx solid var(--line);
  background: var(--paper2);
}

.cl-sim-dot-on {
  background: var(--green-accent);
}

/* quiz */
.cl-quiz-q {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.65;
  margin-bottom: 28rpx;
}

.cl-quiz-opt {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 18rpx;
  border: 3rpx solid var(--line);
  border-radius: 30rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

.cl-quiz-key {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  border: 3rpx solid var(--line);
  border-radius: 50%;
  background: var(--paper2);
}

.cl-quiz-text {
  flex: 1;
  font-size: 29rpx;
  line-height: 1.55;
}

.cl-quiz-right {
  background: var(--green-soft);
  border-color: var(--green-deep);
}

.cl-quiz-right .cl-quiz-key {
  background: var(--green);
}

.cl-quiz-wrong {
  background: #FDECEC;
  border-color: #d98a8a;
}

.cl-quiz-result {
  margin-top: 8rpx;
  padding: 24rpx 28rpx;
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--paper2);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.cl-quiz-verdict {
  font-size: 28rpx;
  font-weight: 800;
}

.cl-quiz-verdict-right {
  color: var(--green-deep);
}

.cl-quiz-verdict-wrong {
  color: #c05050;
}

.cl-quiz-expl {
  font-size: 27rpx;
  line-height: 1.65;
  color: var(--ink-soft);
}

/* summary */
.cl-summary-point {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

.cl-summary-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.cl-summary-text {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.6;
}

/* ---- 字幕条 ---- */
.cl-subtitle {
  margin: 0 36rpx;
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 18rpx 24rpx 8rpx;
}

.cl-subtitle-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--ink-soft);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.cl-subtitle-bar {
  display: flex;
  justify-content: center;
}

.cl-subtitle-arrow {
  width: 32rpx;
  height: 32rpx;
}

.cl-arrow-up {
  transform: rotate(-90deg);
}

.cl-arrow-down {
  transform: rotate(90deg);
}

/* ---- 控制栏 ---- */
.cl-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 36rpx 36rpx;
}

.cl-ctrl {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid var(--line);
  border-radius: 30rpx 26rpx 32rpx 24rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

.cl-ctrl .icon {
  width: 40rpx;
  height: 40rpx;
}

.cl-ctrl-main {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--green);
  border-width: 4rpx;
}

.cl-ctrl-main .icon {
  width: 48rpx;
  height: 48rpx;
}

.cl-ctrl-hover {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.cl-ctrl-auto {
  flex-direction: column;
  gap: 2rpx;
  width: 96rpx;
}

.cl-ctrl-label {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--gray);
}

.cl-ctrl-on {
  background: var(--green-soft2);
  border-color: var(--green-deep);
}

.cl-ctrl-on .cl-ctrl-label {
  color: var(--green-deep);
}

/* ---- 课程完成遮罩 ---- */
.cl-complete-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(30, 38, 33, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.cl-complete-card {
  width: 600rpx;
  padding: 56rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  border: 4rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--paper);
  box-shadow: var(--sh);
}

.cl-complete-icon {
  width: 96rpx;
  height: 96rpx;
}

.cl-complete-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.cl-complete-name {
  font-size: 28rpx;
  color: var(--ink-soft);
}

.cl-complete-stats {
  font-size: 26rpx;
  color: var(--green-deep);
  background: var(--green-soft);
  border: 3rpx solid var(--line);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

.cl-complete-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}

/* ---- 音色选择 ---- */
.cl-voice-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 28rpx 4rpx 0;
}

.cl-voice-label {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--ink-soft);
}

.cl-voice-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* ---- 末页完成课程按钮 ---- */
.cl-finish-wrap {
  display: flex;
  justify-content: center;
  margin-top: 56rpx;
}

.cl-finish-btn {
  padding: 0 96rpx;
}
