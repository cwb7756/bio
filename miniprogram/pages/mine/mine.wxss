/* pages/mine/mine.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

/* ============ 用户信息卡片 ============ */
.profile-card {
  position: relative;
  border: 4rpx solid var(--line);
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: var(--sh);
  margin-top: 12rpx;
}

.profile-bg {
  height: 180rpx;
  background: linear-gradient(135deg, var(--green-accent), var(--green));
  border-bottom: 4rpx solid var(--line);
}

.profile-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 28rpx 28rpx;
  background: var(--paper);
  margin-top: -60rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--line);
  background: var(--green-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--sh-sm);
  flex-shrink: 0;
}

.avatar-emoji {
  width: 60rpx;
  height: 60rpx;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.profile-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.profile-name {
  font-size: 34rpx;
  font-weight: 800;
}

.profile-level {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: var(--green-deep);
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
}

.profile-grade {
  font-size: 25rpx;
  color: var(--ink-soft);
}

.profile-edit {
  font-size: 24rpx;
  font-weight: 700;
  border: 3rpx solid var(--line);
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

/* ============ 学习统计 ============ */
.stats-card {
  display: flex;
  margin-top: 28rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  overflow: hidden;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 30rpx 0;
  border-right: 3rpx solid var(--line);
}

.stats-item:last-child {
  border-right: none;
}

.stats-num-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.stats-num {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--green-deep);
}

.stats-unit {
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

.stats-label {
  font-size: 24rpx;
  color: var(--ink-soft);
  font-weight: 600;
}

/* ============ 成就展示 ============ */
.achievement-row {
  display: flex;
  gap: 18rpx;
}

.achievement-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 8rpx;
  border: 4rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
}

.achievement-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  background: var(--hl);
  display: flex;
  align-items: center;
  justify-content: center;
}

.achievement-icon .icon {
  width: 40rpx;
  height: 40rpx;
}

.achievement-name {
  font-size: 24rpx;
  font-weight: 700;
}

.achievement-desc {
  font-size: 20rpx;
  color: var(--gray);
  text-align: center;
}

/* ============ VIP 横幅 ============ */
.vip-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border: 4rpx solid var(--line);
  border-radius: 36rpx;
  background: linear-gradient(135deg, #FFF9E6, var(--hl));
  box-shadow: var(--sh);
}

.vip-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.vip-icon {
  width: 48rpx;
  height: 48rpx;
}

.vip-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.vip-title {
  font-size: 30rpx;
  font-weight: 800;
}

.vip-desc {
  font-size: 22rpx;
  color: var(--ink-soft);
}

.vip-go {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
  background: var(--green);
  border: 3rpx solid var(--line);
  border-radius: 28rpx;
  padding: 10rpx 24rpx;
  box-shadow: var(--sh-sm);
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.vip-go .icon {
  width: 24rpx;
  height: 24rpx;
}

/* ============ 菜单列表 ============ */
.menu-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 24rpx 26rpx;
  transition: transform .12s;
}

.menu-item:active {
  transform: translate(4rpx, 4rpx);
}

.menu-icon-wrap {
  flex: 0 0 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  border: 3rpx solid var(--line);
  background: var(--green-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-icon-wrap .icon {
  width: 40rpx;
  height: 40rpx;
}

.menu-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-name {
  font-size: 30rpx;
  font-weight: 700;
}

.menu-desc {
  font-size: 23rpx;
  color: var(--gray);
}

.menu-badge {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  background: #E88;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.menu-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-arrow .icon {
  width: 32rpx;
  height: 32rpx;
}
