<!--pages/mine/mine.wxml-->
<view class="page-container">
  <view class="bg-dots"></view>

  <!-- 状态栏占位 -->
  <view style="height: {{statusBarHeight}}px;"></view>

  <view class="page-body">
    <view class="page-pad">
      <!-- 用户信息卡片 -->
      <view class="profile-card">
        <view class="profile-bg"></view>
        <view class="profile-info" bindtap="onProfileTap">
          <view class="profile-avatar">
            <image wx:if="{{user.avatarUrl}}" class="avatar-img" src="{{user.avatarUrl}}" mode="aspectFill"></image>
            <view wx:else class="icon {{user.avatar}} avatar-emoji"></view>
          </view>
          <view class="profile-text">
            <view class="profile-name-row">
              <text class="profile-name">{{user.name}}</text>
              <view class="profile-level" wx:if="{{isLoggedIn}}">
                <text>{{user.level}}</text>
              </view>
            </view>
            <text class="profile-grade">{{user.grade}}</text>
          </view>
          <view class="profile-edit" catchtap="handleAuthBtn">
            <text>{{isLoggedIn ? '退出' : '登录'}}</text>
          </view>
        </view>
      </view>

      <!-- 学习统计 -->
      <view class="stats-card">
        <view
          wx:for="{{stats}}"
          wx:key="label"
          class="stats-item"
        >
          <view class="stats-num-row">
            <text class="stats-num">{{item.num}}</text>
            <text class="stats-unit">{{item.unit}}</text>
          </view>
          <text class="stats-label">{{item.label}}</text>
        </view>
      </view>

      <!-- 成就展示 -->
      <view class="sec-title" bindtap="goAchievements">
        <text class="u">我的成就</text>
        <text class="ach-count" wx:if="{{isLoggedIn && totalAchievements > 0}}">{{unlockedCount}}/{{totalAchievements}}</text>
        <view class="more"><text>全部</text><view class="icon ic-chevron-right more-icon"></view></view>
      </view>
      <view class="achievement-row" wx:if="{{achievements.length > 0}}">
        <view
          wx:for="{{achievements}}"
          wx:key="_id"
          class="achievement-item"
        >
          <view class="achievement-icon">
            <view class="icon {{item.icon}}"></view>
          </view>
          <text class="achievement-name">{{item.name}}</text>
          <text class="achievement-desc">{{item.desc}}</text>
        </view>
      </view>
      <view class="achievement-empty" wx:elif="{{isLoggedIn}}">
        <view class="icon ic-trophy empty-icon"></view>
        <text class="empty-text">完成学习任务即可解锁成就</text>
      </view>

      <!-- 菜单列表 -->
      <view class="menu-list">
        <view
          wx:for="{{menuList}}"
          wx:key="name"
          class="menu-item"
          data-path="{{item.path}}"
          bindtap="goMenu"
        >
          <view class="menu-icon-wrap">
            <view class="icon {{item.icon}} menu-icon"></view>
          </view>
          <view class="menu-info">
            <text class="menu-name">{{item.name}}</text>
            <text class="menu-desc">{{item.desc}}</text>
          </view>
          <view class="menu-badge" wx:if="{{item.badge}}">
            <text>{{item.badge}}</text>
          </view>
          <view class="menu-arrow">
            <view class="icon ic-chevron-right"></view>
          </view>
        </view>
      </view>

      <view style="height: 180rpx;"></view>
    </view>
  </view>
</view>
