/* pages/pet/pet.wxss */
.page-container {
  position: relative;
  z-index: 1;
}

.nav-icon {
  width: 36rpx;
  height: 36rpx;
}

.demo-tip {
  border: 3rpx dashed var(--gray-line);
  border-radius: 24rpx;
  background: var(--hl);
  color: var(--ink-soft);
  font-size: 23rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 8rpx;
}

.loading-tip,
.empty-tip {
  text-align: center;
  color: var(--gray);
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* 猫咪舞台 */
.pet-stage {
  position: relative;
  border: 4rpx solid var(--line);
  border-radius: 40rpx;
  background: linear-gradient(180deg, var(--green-soft), var(--paper));
  box-shadow: var(--sh);
  padding: 40rpx 32rpx 32rpx;
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.pet-lv {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #fff;
  background: var(--green-deep);
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
}

.pet-days {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--ink-soft);
  border: 3rpx solid var(--line);
  border-radius: 20rpx;
  background: var(--paper);
  padding: 4rpx 18rpx;
}

.pet-img {
  width: 420rpx;
  height: 300rpx;
}

.pet-name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.pet-sign {
  font-size: 23rpx;
  color: var(--gray);
  margin-top: 6rpx;
}

.xp-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 24rpx;
}

.xp-icon {
  width: 32rpx;
  height: 32rpx;
}

.xp-bar {
  flex: 1;
  height: 26rpx;
  border: 3rpx solid var(--line);
  border-radius: 16rpx;
  background: var(--paper);
  overflow: hidden;
}

.xp-fill {
  height: 100%;
  background: var(--green);
  border-radius: 10rpx;
}

.xp-num {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--ink-soft);
}

/* 三项状态 */
.meters {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.meter {
  flex: 1;
  border: 4rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 20rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.m-ic {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.m-ic .icon {
  width: 30rpx;
  height: 30rpx;
}

.m-ic-pink {
  background: #FBE7EF;
}

.m-ic-orange {
  background: #FDEBD3;
}

.m-ic-yellow {
  background: var(--hl);
}

.m-val {
  font-size: 28rpx;
  font-weight: 800;
}

.m-label {
  font-size: 21rpx;
  color: var(--gray);
}

.m-bar {
  width: 100%;
  height: 14rpx;
  border: 2rpx solid var(--line);
  border-radius: 10rpx;
  background: var(--paper2);
  overflow: hidden;
}

.m-fill {
  height: 100%;
  background: #F0A8C0;
}

.m-fill-orange {
  background: #F0B26B;
}

.m-fill-green {
  background: var(--green-deep);
}

/* 小鱼干卡 */
.fish-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 24rpx 26rpx;
  margin-top: 24rpx;
}

.f-ic {
  flex: 0 0 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  border: 3rpx solid var(--line);
  background: var(--hl);
  display: flex;
  align-items: center;
  justify-content: center;
}

.f-ic .icon {
  width: 42rpx;
  height: 42rpx;
}

.f-txt {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.f-num {
  font-size: 34rpx;
  font-weight: 800;
}

.f-desc {
  font-size: 21rpx;
  color: var(--gray);
}

.f-btn {
  font-size: 24rpx;
  font-weight: 700;
  border: 3rpx solid var(--line);
  border-radius: 26rpx;
  background: var(--green);
  box-shadow: var(--sh-sm);
  padding: 12rpx 22rpx;
  white-space: nowrap;
}

.f-btn:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

/* 互动 */
.interact {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.ia-btn {
  flex: 1;
  border: 4rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 24rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.ia-btn:active {
  transform: translate(3rpx, 3rpx);
  box-shadow: none;
}

.ia-btn.lock {
  opacity: .65;
}

.ia-ic {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  background: var(--green-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ia-ic .icon {
  width: 34rpx;
  height: 34rpx;
}

.ia-name {
  font-size: 27rpx;
  font-weight: 800;
}

.ia-cost {
  font-size: 20rpx;
  color: var(--gray);
}

/* 成长日记 */
.diary {
  display: flex;
  gap: 18rpx;
  border: 4rpx solid var(--line);
  border-radius: 28rpx;
  background: var(--paper);
  box-shadow: var(--sh-sm);
  padding: 22rpx 26rpx;
  margin-bottom: 18rpx;
}

.d-time {
  flex: 0 0 90rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--green-deep);
}

.d-text {
  flex: 1;
  font-size: 25rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}
