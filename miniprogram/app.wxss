/**app.wxss**/
/* ============ 设计系统 · Design Tokens ============ */
page {
  /* 颜色 */
  --green: #8FD3A8;
  --green-accent: #5FB894;
  --green-deep: #3D9970;
  --green-soft: #E8F5EE;
  --green-soft2: #D6EFE0;
  --bg: #F1F6F0;
  --paper: #FCFDFB;
  --paper2: #FBFDFB;
  --ink: #1E2621;
  --ink-soft: #4A554E;
  --line: #4A5852;
  --gray: #98A29B;
  --gray-line: #D5DED8;
  --hl: #FFF0A6;

  /* 手绘阴影：降黑 + 微模糊 + 降透明度，弱化对比 */
  --sh: 5rpx 5rpx 1rpx rgba(74, 88, 82, .42);
  --sh-sm: 3rpx 3rpx 1rpx rgba(74, 88, 82, .34);
  --sh-green: 5rpx 5rpx 1rpx rgba(61, 153, 112, .45);
  --sh-soft: 0 16rpx 40rpx rgba(30, 38, 33, .10);

  /* 字体 */
  --f-hand: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --f-cn-hand: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  --f-body: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;

  /* 手绘圆角变体 */
  --r1: 510rpx 30rpx 450rpx 30rpx / 30rpx 450rpx 30rpx 510rpx;
  --r2: 30rpx 450rpx 30rpx 510rpx / 510rpx 30rpx 450rpx 30rpx;
  --r3: 450rpx 30rpx 510rpx 30rpx / 30rpx 510rpx 30rpx 450rpx;

  background: var(--bg);
  color: var(--ink);
  font-family: var(--f-body);
  font-size: 28rpx;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, swiper, input, textarea, button {
  box-sizing: border-box;
}

/* ============ 通用手绘组件 ============ */
.sketch {
  border: 4rpx solid var(--line);
  border-radius: var(--r1);
  background: var(--paper);
  box-shadow: var(--sh);
}

.card {
  border: 4rpx solid var(--line);
  border-radius: 40rpx;
  background: var(--paper);
  box-shadow: var(--sh);
  padding: 30rpx;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-family: var(--f-body);
  font-weight: 700;
  font-size: 30rpx;
  border: 4rpx solid var(--line);
  border-radius: 32rpx 28rpx 34rpx 26rpx;
  padding: 24rpx 36rpx;
  background: var(--green);
  color: var(--ink);
  box-shadow: var(--sh);
  transition: transform .12s, box-shadow .12s;
  line-height: 1.2;
}

.btn:active {
  transform: translate(6rpx, 6rpx);
  box-shadow: 0 0 0 var(--ink);
}

.btn.ghost {
  background: var(--paper);
}

.btn.deep {
  background: var(--green-accent);
  color: #fff;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 25rpx;
  font-weight: 700;
  border: 3rpx solid var(--line);
  border-radius: 40rpx;
  padding: 6rpx 22rpx;
  background: var(--paper);
}

.chip.on {
  background: var(--green);
}

.hl {
  background: linear-gradient(180deg, transparent 55%, var(--hl) 55%);
  padding: 0 4rpx;
}

.sec-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 800;
  margin: 40rpx 8rpx 24rpx;
}

.sec-title .u {
  position: relative;
}

.sec-title .u::after {
  content: "";
  position: absolute;
  left: -4rpx;
  right: -4rpx;
  bottom: -6rpx;
  height: 12rpx;
  background: var(--green);
  border-radius: 12rpx;
  z-index: -1;
  opacity: .7;
}

.sec-title .more {
  margin-left: auto;
  font-size: 25rpx;
  font-weight: 700;
  color: var(--green-deep);
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.more-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 分段控件 */
.segment {
  display: flex;
  gap: 0;
  border: 4rpx solid var(--line);
  border-radius: 32rpx;
  overflow: hidden;
  background: var(--paper);
}

.segment .seg-item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  font-weight: 700;
  padding: 16rpx 0;
  border-right: 3rpx solid var(--line);
}

.segment .seg-item:last-child {
  border-right: none;
}

.segment .seg-item.on {
  background: var(--green);
  position: relative;
}

/* 搜索框 */
.search {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 4rpx solid var(--line);
  border-radius: 44rpx;
  background: var(--paper);
  padding: 20rpx 30rpx;
  box-shadow: var(--sh-sm);
}

.search input {
  border: none;
  outline: none;
  background: transparent;
  font-family: var(--f-body);
  font-size: 28rpx;
  flex: 1;
  color: var(--ink);
}

.search input::placeholder {
  color: var(--gray);
}

/* 状态栏占位 */
.statusbar {
  height: 88rpx;
  flex: 0 0 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 48rpx 0 52rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.statusbar .r {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 页面内导航栏 */
.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 36rpx 24rpx;
}

.navbar .nav-t {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.icon-btn {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper);
  border: 3rpx solid var(--line);
  border-radius: 28rpx 24rpx 30rpx 22rpx;
  box-shadow: var(--sh-sm);
  font-size: 36rpx;
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  gap: 22rpx;
  padding: 24rpx 36rpx;
  border-top: 4rpx solid var(--line);
  background: var(--paper);
}

.action-bar .btn {
  flex: 1;
}

/* 内容区 */
.page-body {
  flex: 1;
  overflow: visible;
}

.page-pad {
  padding: 12rpx 36rpx 36rpx;
}

/* 页面容器 */
.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--bg);
}

/* 背景点状纹理 */
.bg-dots {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: radial-gradient(circle, rgba(95,184,148,.12) 2.4rpx, transparent 2.4rpx);
  background-size: 44rpx 44rpx;
  pointer-events: none;
  z-index: 0;
}

/* ============ 通用 SVG 线性图标系统 ============ */
.icon {
  display: inline-block;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

