<!-- miniprogram/packages/3d-model/components/xr-model-viewer/index.wxml -->
<!-- xr-frame 场景：gltf 资产加载 + 固定相机 + 双光源；手势（旋转/惯性/缩放）由 index.js 自定义实现 -->
<xr-scene bind:ready="handleReady">
  <xr-assets bind:loaded="handleAssetsLoaded">
    <xr-asset-load
      wx:if="{{src}}"
      type="gltf"
      asset-id="model"
      src="{{src}}"
      bind:error="handleAssetError"
    />
  </xr-assets>

  <!-- 模型挂载节点：tick 中绕 y 轴自动旋转；资产真正加载完成后才创建 xr-gltf -->
  <!-- 注意：getElementById 查的是 id 属性，camera target 查的是 node-id，两者必须都设 -->
  <xr-node id="model-wrap" node-id="model-wrap">
    <xr-gltf wx:if="{{src && loaded}}" model="model" scale="0.3 0.3 0.3" />
  </xr-node>

  <!-- clear-color 对应全局 --bg #F1F6F0 纸感浅绿底 -->
  <xr-camera
    id="camera"
    node-id="camera"
    position="0 0.6 4.5"
    target="model-wrap"
    clear-color="0.945 0.965 0.941 1"
  />

  <xr-node node-id="lights">
    <xr-light type="ambient" color="1 1 1" intensity="0.9" />
    <xr-light type="directional" rotation="40 70 0" color="1 1 1" intensity="1.6" />
  </xr-node>
</xr-scene>
